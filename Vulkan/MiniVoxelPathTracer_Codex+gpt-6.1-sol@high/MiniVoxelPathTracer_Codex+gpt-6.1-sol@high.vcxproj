  <!-- VS 委托同一份 CMake 配置构建，避免两套依赖链接规则逐渐偏离。 -->
  <PropertyGroup>
    <ArenaCMake>$(VSInstallDir)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</ArenaCMake>
    <ArenaPreset Condition="'$(Configuration)'=='Debug'">windows-msvc-debug</ArenaPreset>
    <ArenaPreset Condition="'$(Configuration)'=='Release'">windows-msvc-release</ArenaPreset>
    <ArenaVcpkgRoot Condition="'$(VCPKG_ROOT)'!=''">$(VCPKG_ROOT)</ArenaVcpkgRoot>
    <ArenaVcpkgRoot Condition="'$(VCPKG_ROOT)'==''">$(VSInstallDir)VC\vcpkg</ArenaVcpkgRoot>
    <OutDir>$(ProjectDir)out\$(ArenaPreset)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)out\$(ArenaPreset)\vs\</IntDir>
    <NMakeBuildCommandLine>set "VCPKG_ROOT=$(ArenaVcpkgRoot)"&#xD;&#xA;cd /d "$(ProjectDir)" &amp;&amp; "$(ArenaCMake)" --preset $(ArenaPreset) &amp;&amp; "$(ArenaCMake)" --build "out\$(ArenaPreset)" --config $(Configuration)</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>set "VCPKG_ROOT=$(ArenaVcpkgRoot)"&#xD;&#xA;cd /d "$(ProjectDir)" &amp;&amp; "$(ArenaCMake)" --preset $(ArenaPreset) &amp;&amp; "$(ArenaCMake)" --build "out\$(ArenaPreset)" --config $(Configuration) --clean-first</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>cd /d "$(ProjectDir)" &amp;&amp; if exist "out\$(ArenaPreset)\CMakeCache.txt" "$(ArenaCMake)" --build "out\$(ArenaPreset)" --config $(Configuration) --target clean</NMakeCleanCommandLine>
    <NMakeOutput>$(OutDir)MiniVoxelPathTracer.exe</NMakeOutput>
    <NMakeIncludeSearchPath>$(ProjectDir);$(ProjectDir)out\$(ArenaPreset)\vcpkg_installed\x64-windows\include;$(ProjectDir)out\$(ArenaPreset)\vcpkg_installed\x64-windows\include\vma;$(NMakeIncludeSearchPath)</NMakeIncludeSearchPath>
    <AdditionalOptions>/std:c++20 %(AdditionalOptions)</AdditionalOptions>
    <LocalDebuggerCommand>$(NMakeOutput)</LocalDebuggerCommand>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Include="main.cpp" />
  </ItemGroup>
  <ItemGroup>
