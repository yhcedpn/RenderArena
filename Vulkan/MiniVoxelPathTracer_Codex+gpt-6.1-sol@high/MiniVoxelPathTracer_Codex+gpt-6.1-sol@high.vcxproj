    <ProjectGuid>{f76d95dd-11ee-4bfc-bfba-caa0e1ca4778}</ProjectGuid>
    <RootNamespace>MiniVoxelPathTracerCodexgpt61solhigh</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
