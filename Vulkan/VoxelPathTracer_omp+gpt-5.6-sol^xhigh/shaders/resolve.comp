#version 460
#include "common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint pixel = linearInvocationIndex();
    if (pixel >= pixelCount()) return;
    BranchOutput a = branchOutputs[branchIndex(pixel, 0u)];
    BranchOutput b = branchOutputs[branchIndex(pixel, 1u)];
    for (uint domain = 0u; domain < DOMAIN_COUNT; ++domain) {
        atrousA[domainIndex(pixel, domain)] = getSignal(a, domain) + getSignal(b, domain);
    }
}
