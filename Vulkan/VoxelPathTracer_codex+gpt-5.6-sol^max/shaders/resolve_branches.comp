#version 460
#include "common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void insertGuide(inout GuidePixel pixel, Guide guide) {
    if (guide.ids.x == 0u) return;
    if (pixel.guides[0].ids.x == 0u || guideDomain(pixel.guides[0]) == guideDomain(guide)) {
        pixel.guides[0] = guide;
    } else {
        pixel.guides[1] = guide;
    }
}

void main() {
    uint pixel = gl_GlobalInvocationID.x;
    if (pixel >= pixelCount()) return;
    SignalPixel signals;
    for (uint domain = 0u; domain < DOMAIN_COUNT; ++domain) signals.signal[domain] = vec4(0.0);
    signals.emission = vec4(0.0);
    GuidePixel guidePixel;
    guidePixel.guides[0] = emptyGuide();
    guidePixel.guides[1] = emptyGuide();
    for (uint branch = 0u; branch < 2u; ++branch) {
        BranchOutput branchResult = branchOutputs[branchIndex(pixel, branch)];
        signals.emission += branchResult.analyticEmission;
        if (branchResult.meta.y != 0u && branchResult.meta.x < DOMAIN_COUNT) {
            signals.signal[branchResult.meta.x] += branchResult.radiance;
            insertGuide(guidePixel, branchResult.guide);
        }
    }
    signalsCurrent[pixel] = signals;
    guidesCurrent[pixel] = guidePixel;
}
