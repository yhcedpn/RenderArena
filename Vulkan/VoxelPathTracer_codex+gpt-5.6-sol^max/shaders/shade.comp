#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

const float PI = 3.141592653589793;

void setDomain(uint branch, uint domain) {
    uint recordIndex = currentBranchBase() + branch;
    BranchRecord record = branchRecords[recordIndex];
    record.metadata.x = domain;
    record.metadata.y = 1u;
    branchRecords[recordIndex] = record;
}

void addRadiance(PathState path, vec3 contribution) {
    uint recordIndex = currentBranchBase() + path.identity.y;
    BranchRecord record = branchRecords[recordIndex];
    record.radiance.xyz += contribution;
    record.metadata.x = path.optical.z;
    record.metadata.y = 1u;
    branchRecords[recordIndex] = record;
}

vec3 applyReflectionPoint(PathState path, vec3 point) {
    vec4 homogeneous = vec4(point, 1.0);
    return vec3(dot(path.reflectionRow0, homogeneous), dot(path.reflectionRow1, homogeneous),
                dot(path.reflectionRow2, homogeneous));
}

vec3 applyReflectionNormal(PathState path, vec3 normal) {
    return normalize(vec3(dot(path.reflectionRow0.xyz, normal), dot(path.reflectionRow1.xyz, normal),
                          dot(path.reflectionRow2.xyz, normal)));
}

void appendReflectionTransform(inout PathState path, vec3 planeNormal, vec3 pointOnPlane, uint surface) {
    vec3 n = normalize(planeNormal);
    mat3 linear = mat3(1.0) - 2.0 * outerProduct(n, n);
    vec3 translation = 2.0 * n * dot(n, pointOnPlane);
    vec4 old0 = path.reflectionRow0;
    vec4 old1 = path.reflectionRow1;
    vec4 old2 = path.reflectionRow2;
    path.reflectionRow0 = vec4(old0.xyz * linear, dot(old0.xyz, translation) + old0.w);
    path.reflectionRow1 = vec4(old1.xyz * linear, dot(old1.xyz, translation) + old1.w);
    path.reflectionRow2 = vec4(old2.xyz * linear, dot(old2.xyz, translation) + old2.w);
    path.optical.x = hashCombine(path.optical.x, surface ^ 0x51ed270bu);
    path.optical.y += 1u;
}

uint classifyDomain(PathState path, uint materialType) {
    if (path.optical.z != DOMAIN_UNCLASSIFIED) return path.optical.z;
    bool specularTerminal = materialType != MATERIAL_DIFFUSE;
    if ((path.identity.w & FLAG_OPTICAL_MIRROR) != 0u) {
        return specularTerminal ? DOMAIN_REFLECTION_SPECULAR : DOMAIN_REFLECTION_DIFFUSE;
    }
    return specularTerminal ? DOMAIN_ORDINARY_SPECULAR : DOMAIN_ORDINARY_DIFFUSE;
}

void establishGuide(inout PathState path, vec3 position, vec3 normal, float distanceValue,
                    uint surface, uint materialIndex, vec3 albedo, float roughness, uint materialType) {
    uint recordIndex = currentBranchBase() + path.identity.y;
    BranchRecord record = branchRecords[recordIndex];
    if (record.guide.albedoValidity.w >= 0.5) return;
    uint domain = classifyDomain(path, materialType);
    path.optical.z = domain;
    bool pureReflection = (domain == DOMAIN_REFLECTION_DIFFUSE || domain == DOMAIN_REFLECTION_SPECULAR ||
                           domain == DOMAIN_GLASS_REFLECTION) &&
                          (path.identity.w & FLAG_HAS_TRANSMISSION) == 0u;
    vec3 guidePosition = pureReflection ? applyReflectionPoint(path, position) : position;
    vec3 guideNormal = pureReflection ? applyReflectionNormal(path, normal) : normal;
    record.guide.positionDistance = vec4(guidePosition, distanceValue);
    record.guide.normalRoughness = vec4(guideNormal, roughness);
    record.guide.albedoValidity = vec4(albedo, 1.0);
    uint opticalBits = (path.identity.w & (FLAG_HAS_TRANSMISSION | FLAG_OPTICAL_MIRROR |
                                           FLAG_OPTICAL_GLASS_REFLECT | FLAG_OPTICAL_GLASS_TRANSMIT)) >> 2u;
    record.guide.identity = uvec4(surface, materialIndex, path.optical.x,
                                  (path.optical.y & 0xffu) | (opticalBits << 8u));
    record.metadata = uvec4(domain, 1u, path.identity.w, materialType);
    branchRecords[recordIndex] = record;
}

float rayOffset(vec3 position) {
    return 0.0002 + 0.00001 * max(abs(position.x), max(abs(position.y), abs(position.z)));
}

bool appendPath(uint queueIndex, PathState path) {
    uint destination = queueIndex == 0u ? atomicAdd(countA, 1u) : atomicAdd(countB, 1u);
    if (destination >= branchCapacity()) {
        atomicOr(overflowFlag, 1u);
        return false;
    }
    writePath(queueIndex, destination, path);
    return true;
}

void appendShadowTask(PathState path, vec3 point, vec3 normal, vec3 direction, float distanceValue,
                      vec3 contribution, uint kind) {
    uint destination = atomicAdd(shadowCount, 1u);
    if (destination >= branchCapacity()) {
        atomicOr(overflowFlag, 2u);
        return;
    }
    float epsilon = rayOffset(point);
    vec3 offsetNormal = dot(direction, normal) >= 0.0 ? normal : -normal;
    ShadowTask task;
    task.originTMax = vec4(point + offsetNormal * epsilon, max(distanceValue - 2.0 * epsilon, epsilon));
    task.direction = vec4(direction, 0.0);
    task.contribution = vec4(contribution, 0.0);
    task.identity = uvec4(path.identity.y, path.optical.z, kind, 0u);
    shadowTasks[destination] = task;
}

void makeBasis(vec3 normal, out vec3 tangent, out vec3 bitangent) {
    float signValue = normal.z >= 0.0 ? 1.0 : -1.0;
    float a = -1.0 / (signValue + normal.z);
    float b = normal.x * normal.y * a;
    tangent = vec3(1.0 + signValue * normal.x * normal.x * a, signValue * b, -signValue * normal.x);
    bitangent = vec3(b, signValue + normal.y * normal.y * a, -normal.y);
}

vec3 cosineHemisphere(vec3 normal, float u0, float u1) {
    float radius = sqrt(u0);
    float angle = 2.0 * PI * u1;
    vec3 tangent;
    vec3 bitangent;
    makeBasis(normal, tangent, bitangent);
    return normalize(tangent * (radius * cos(angle)) + bitangent * (radius * sin(angle)) +
                     normal * sqrt(max(0.0, 1.0 - u0)));
}

vec3 sampleGgxVndf(vec3 normal, vec3 wo, float alpha, float u0, float u1) {
    vec3 tangent;
    vec3 bitangent;
    makeBasis(normal, tangent, bitangent);
    vec3 localView = vec3(dot(wo, tangent), dot(wo, bitangent), dot(wo, normal));
    vec3 stretched = normalize(vec3(alpha * localView.xy, localView.z));
    float lensq = dot(stretched.xy, stretched.xy);
    vec3 basis1 = lensq > 0.0 ? vec3(-stretched.y, stretched.x, 0.0) * inversesqrt(lensq) : vec3(1.0, 0.0, 0.0);
    vec3 basis2 = cross(stretched, basis1);
    float radius = sqrt(u0);
    float phi = 2.0 * PI * u1;
    float t1 = radius * cos(phi);
    float t2 = radius * sin(phi);
    float blend = 0.5 * (1.0 + stretched.z);
    t2 = mix(sqrt(max(0.0, 1.0 - t1 * t1)), t2, blend);
    vec3 sampled = t1 * basis1 + t2 * basis2 + sqrt(max(0.0, 1.0 - t1 * t1 - t2 * t2)) * stretched;
    vec3 localHalf = normalize(vec3(alpha * sampled.xy, max(sampled.z, 0.0)));
    vec3 halfVector = normalize(tangent * localHalf.x + bitangent * localHalf.y + normal * localHalf.z);
    return reflect(-wo, halfVector);
}

float dielectricFresnel(float cosine, float etaIncident, float etaTransmitted) {
    float sinTransmitted = etaIncident / etaTransmitted * sqrt(max(0.0, 1.0 - cosine * cosine));
    if (sinTransmitted >= 1.0) return 1.0;
    float cosTransmitted = sqrt(max(0.0, 1.0 - sinTransmitted * sinTransmitted));
    float parallel = (etaTransmitted * cosine - etaIncident * cosTransmitted) /
                     (etaTransmitted * cosine + etaIncident * cosTransmitted);
    float perpendicular = (etaIncident * cosine - etaTransmitted * cosTransmitted) /
                          (etaIncident * cosine + etaTransmitted * cosTransmitted);
    return 0.5 * (parallel * parallel + perpendicular * perpendicular);
}

bool applyRussianRoulette(inout PathState path, uint eventCount, uint dimension) {
    if (eventCount < 4u) return true;
    float survival = clamp(maxComponent(path.throughputLastPdf.xyz), 0.05, 0.95);
    if (randomDimension(path.identity.x, path.identity.y & 1u, eventCount, dimension) >= survival) return false;
    path.throughputLastPdf.xyz /= survival;
    return true;
}

void enqueueContinuation(uint nextQueue, inout PathState path, vec3 hitPoint, vec3 direction,
                         uint eventCount, uint rrDimension) {
    path.identity.z = eventCount;
    path.identity.w &= ~FLAG_PRIMARY_SEGMENT;
    if (!applyRussianRoulette(path, eventCount, rrDimension)) return;
    float epsilon = rayOffset(hitPoint);
    path.originConeWidth.xyz = hitPoint + direction * epsilon;
    path.directionConeSpread.xyz = normalize(direction);
    appendPath(nextQueue, path);
}

void makeNeeTask(PathState path, vec3 point, vec3 normal, vec3 wo, uint materialType,
                 vec3 albedo, float roughness, uint bounce) {
    float uLight = randomDimension(path.identity.x, path.identity.y & 1u, bounce, 20u);
    uint lightIndex = selectLight(uLight);
    vec2 bary = sampleTriangle(randomDimension(path.identity.x, path.identity.y & 1u, bounce, 21u),
                               randomDimension(path.identity.x, path.identity.y & 1u, bounce, 22u));
    Light light = lights[lightIndex];
    vec3 lightPoint = lightPosition(light, bary);
    vec3 delta = lightPoint - point;
    float distanceSquared = dot(delta, delta);
    if (distanceSquared <= 1e-10) return;
    float distanceValue = sqrt(distanceSquared);
    vec3 wi = delta / distanceValue;
    float receiverCosine = max(dot(normal, wi), 0.0);
    float emitterCosine = max(dot(light.normalCdf.xyz, -wi), 0.0);
    if (receiverCosine <= 0.0 || emitterCosine <= 0.0) return;
    float bsdfPdf;
    vec3 bsdf = evaluateBsdf(materialType, albedo, roughness, normal, wo, wi, bsdfPdf);
    float areaPdf = light.edge1SelectionPdf.w * light.edge2AreaPdf.w;
    float directionPdf = areaPdf * distanceSquared / emitterCosine;
    float mis = powerHeuristic(directionPdf, bsdfPdf);
    vec3 emission = materials[light.metadata.y].emissionRoughness.xyz;
    vec3 contribution = path.throughputLastPdf.xyz * bsdf * receiverCosine * emission *
                        emitterCosine / max(distanceSquared * areaPdf, 1e-20) * mis;
    appendShadowTask(path, point, normal, wi, distanceValue, contribution, 0u);
}

void main() {
    uint queueIndex = pc.params.x;
    uint nextQueue = 1u - queueIndex;
    uint index = gl_GlobalInvocationID.x;
    uint activeCount = queueCount(queueIndex);
    if (index >= activeCount) return;

    PathState path = readPath(queueIndex, index);
    HitState hit = hitStates[index];
    uint flags = path.identity.w;
    if (hit.distanceBarycentric.w < 0.5) {
        return; // The environment is exactly black.
    }

    uint triangleIndex = hit.identity.x;
    Triangle triangle = triangles[triangleIndex];
    uint i0 = indices[triangleIndex * 3u + 0u];
    uint i1 = indices[triangleIndex * 3u + 1u];
    uint i2 = indices[triangleIndex * 3u + 2u];
    Vertex v0 = vertices[i0];
    Vertex v1 = vertices[i1];
    Vertex v2 = vertices[i2];
    float b1 = hit.distanceBarycentric.y;
    float b2 = hit.distanceBarycentric.z;
    float b0 = 1.0 - b1 - b2;
    vec3 geometricNormal = normalize(v0.normalV.xyz);
    vec3 orientedNormal = dot(path.directionConeSpread.xyz, geometricNormal) < 0.0 ? geometricNormal : -geometricNormal;
    vec3 hitPoint = path.originConeWidth.xyz + path.directionConeSpread.xyz * hit.distanceBarycentric.x;
    vec2 uv = vec2(v0.positionU.w, v0.normalV.w) * b0 + vec2(v1.positionU.w, v1.normalV.w) * b1 +
              vec2(v2.positionU.w, v2.normalV.w) * b2;
    uint materialIndex = triangle.metadata.y;
    Material material = materials[materialIndex];
    float footprint = path.originConeWidth.w + path.directionConeSpread.w * hit.distanceBarycentric.x;
    float lod = clamp(log2(max(footprint * float(material.metadata.z), 1.0)), 0.0, float(material.metadata.w - 1u));
    vec3 albedo = textureLod(sampler2DArray(baseColorTexture, materialSampler),
                             vec3(uv, float(material.metadata.y)), lod).rgb;
    float roughness = textureLod(sampler2DArray(roughnessTexture, materialSampler),
                                 vec3(uv, float(material.metadata.y)), lod).r;

    if ((flags & FLAG_INSIDE_MEDIUM) != 0u && path.optical.w != INVALID_INDEX) {
        vec3 absorption = materials[path.optical.w].absorptionIor.xyz;
        path.throughputLastPdf.xyz *= exp(-absorption * hit.distanceBarycentric.x);
    }

    uint materialType = material.metadata.x;
    bool outwardEmission = dot(geometricNormal, -path.directionConeSpread.xyz) > 0.0;
    if (materialType == MATERIAL_EMISSIVE) {
        if (!outwardEmission || (flags & FLAG_SUPPRESS_EMITTER) != 0u) return;
        if (path.optical.z == DOMAIN_UNCLASSIFIED && path.optical.y == 0u) {
            path.optical.z = DOMAIN_ANALYTIC;
            setDomain(path.identity.y, DOMAIN_ANALYTIC);
        } else {
            establishGuide(path, hitPoint, orientedNormal, hit.distanceBarycentric.x, triangle.metadata.x,
                           materialIndex, albedo, roughness, materialType);
        }
        float mis = 1.0;
        if ((flags & FLAG_LAST_DELTA) == 0u && triangle.metadata.z != INVALID_INDEX) {
            float emitterCosine = max(dot(geometricNormal, -path.directionConeSpread.xyz), 1e-8);
            float lightDirectionPdf = triangle.geometry.y * hit.distanceBarycentric.x * hit.distanceBarycentric.x /
                                      emitterCosine;
            mis = powerHeuristic(path.throughputLastPdf.w, lightDirectionPdf);
        }
        addRadiance(path, path.throughputLastPdf.xyz * material.emissionRoughness.xyz * mis);
        return;
    }

    if (path.identity.z >= 8u) return; // Final post-budget segment may only complete on emission or miss.
    path.identity.w &= ~FLAG_SUPPRESS_EMITTER;
    uint eventCount = path.identity.z + 1u;
    vec3 wo = -path.directionConeSpread.xyz;

    if (materialType == MATERIAL_MIRROR) {
        if (path.optical.z == DOMAIN_UNCLASSIFIED) path.identity.w |= FLAG_OPTICAL_MIRROR;
        appendReflectionTransform(path, geometricNormal, hitPoint, triangle.metadata.x);
        path.throughputLastPdf.xyz *= albedo;
        path.throughputLastPdf.w = 0.0;
        path.identity.w |= FLAG_LAST_DELTA;
        path.identity.w &= ~FLAG_SUPPRESS_EMITTER;
        vec3 reflected = reflect(path.directionConeSpread.xyz, orientedNormal);
        enqueueContinuation(nextQueue, path, hitPoint, reflected, eventCount, 30u);
        return;
    }

    if (materialType == MATERIAL_DIELECTRIC) {
        bool inside = (path.identity.w & FLAG_INSIDE_MEDIUM) != 0u;
        float etaIncident = inside ? material.absorptionIor.w : 1.0;
        float etaTransmitted = inside ? 1.0 : material.absorptionIor.w;
        vec3 boundaryNormal = inside ? -geometricNormal : geometricNormal;
        if (dot(boundaryNormal, path.directionConeSpread.xyz) > 0.0) boundaryNormal = -boundaryNormal;
        float cosine = clamp(-dot(path.directionConeSpread.xyz, boundaryNormal), 0.0, 1.0);
        float eta = etaIncident / etaTransmitted;
        float sinSquaredTransmitted = eta * eta * max(0.0, 1.0 - cosine * cosine);
        bool totalInternalReflection = sinSquaredTransmitted >= 1.0;
        float fresnel = totalInternalReflection ? 1.0 : dielectricFresnel(cosine, etaIncident, etaTransmitted);
        vec3 reflected = reflect(path.directionConeSpread.xyz, boundaryNormal);
        bool firstSplit = (path.identity.w & FLAG_GLASS_SPLIT) == 0u;

        if (firstSplit) {
            path.identity.w |= FLAG_GLASS_SPLIT | FLAG_LAST_DELTA;
            path.identity.w &= ~FLAG_SUPPRESS_EMITTER;
            PathState reflectionPath = path;
            reflectionPath.identity.w |= FLAG_OPTICAL_GLASS_REFLECT;
            reflectionPath.identity.w &= ~FLAG_OPTICAL_GLASS_TRANSMIT;
            if (reflectionPath.optical.z == DOMAIN_UNCLASSIFIED) reflectionPath.optical.z = DOMAIN_GLASS_REFLECTION;
            appendReflectionTransform(reflectionPath, geometricNormal, hitPoint, triangle.metadata.x);
            reflectionPath.throughputLastPdf.xyz *= fresnel;
            setDomain(reflectionPath.identity.y, reflectionPath.optical.z);
            enqueueContinuation(nextQueue, reflectionPath, hitPoint, reflected, eventCount, 31u);

            if (!totalInternalReflection) {
                float cosTransmitted = sqrt(max(0.0, 1.0 - sinSquaredTransmitted));
                vec3 transmitted = normalize(eta * path.directionConeSpread.xyz +
                                             (eta * cosine - cosTransmitted) * boundaryNormal);
                PathState transmissionPath = path;
                transmissionPath.identity.y = path.identity.x * 2u + 1u;
                transmissionPath.identity.w |= FLAG_HAS_TRANSMISSION | FLAG_OPTICAL_GLASS_TRANSMIT;
                transmissionPath.identity.w &= ~FLAG_OPTICAL_GLASS_REFLECT;
                transmissionPath.identity.w ^= FLAG_INSIDE_MEDIUM;
                transmissionPath.optical.z = DOMAIN_GLASS_TRANSMISSION;
                transmissionPath.optical.w = inside ? INVALID_INDEX : materialIndex;
                transmissionPath.optical.x = hashCombine(transmissionPath.optical.x,
                                                          triangle.metadata.x ^ 0xa341316cu);
                transmissionPath.optical.y += 1u;
                transmissionPath.throughputLastPdf.xyz *= (1.0 - fresnel) * eta * eta;
                setDomain(transmissionPath.identity.y, DOMAIN_GLASS_TRANSMISSION);
                enqueueContinuation(nextQueue, transmissionPath, hitPoint, transmitted, eventCount, 32u);
            }
            return;
        }

        path.identity.w |= FLAG_LAST_DELTA;
        path.identity.w &= ~FLAG_SUPPRESS_EMITTER;
        float choice = randomDimension(path.identity.x, path.identity.y & 1u, eventCount, 33u);
        if (totalInternalReflection || choice < fresnel) {
            appendReflectionTransform(path, geometricNormal, hitPoint, triangle.metadata.x);
            enqueueContinuation(nextQueue, path, hitPoint, reflected, eventCount, 34u);
        } else {
            float cosTransmitted = sqrt(max(0.0, 1.0 - sinSquaredTransmitted));
            vec3 transmitted = normalize(eta * path.directionConeSpread.xyz +
                                         (eta * cosine - cosTransmitted) * boundaryNormal);
            path.throughputLastPdf.xyz *= eta * eta;
            path.identity.w ^= FLAG_INSIDE_MEDIUM;
            path.identity.w |= FLAG_HAS_TRANSMISSION | FLAG_OPTICAL_GLASS_TRANSMIT;
            path.optical.w = inside ? INVALID_INDEX : materialIndex;
            path.optical.x = hashCombine(path.optical.x, triangle.metadata.x ^ 0xc8013ea4u);
            path.optical.y += 1u;
            if (path.optical.z == DOMAIN_GLASS_REFLECTION || path.optical.z == DOMAIN_UNCLASSIFIED) {
                path.optical.z = DOMAIN_GLASS_TRANSMISSION;
                setDomain(path.identity.y, DOMAIN_GLASS_TRANSMISSION);
            }
            enqueueContinuation(nextQueue, path, hitPoint, transmitted, eventCount, 35u);
        }
        return;
    }

    establishGuide(path, hitPoint, orientedNormal, hit.distanceBarycentric.x, triangle.metadata.x,
                   materialIndex, albedo, roughness, materialType);
    bool directPrimary = path.identity.z == 0u && path.optical.y == 0u &&
                         (path.identity.w & (FLAG_HAS_TRANSMISSION | FLAG_OPTICAL_MIRROR)) == 0u;
    if (!directPrimary) makeNeeTask(path, hitPoint, orientedNormal, wo, materialType, albedo, roughness, eventCount);

    vec3 wi;
    float pdf;
    vec3 bsdf;
    float u0 = randomDimension(path.identity.x, path.identity.y & 1u, eventCount, 40u);
    float u1 = randomDimension(path.identity.x, path.identity.y & 1u, eventCount, 41u);
    if (materialType == MATERIAL_DIFFUSE) {
        wi = cosineHemisphere(orientedNormal, u0, u1);
        pdf = max(dot(orientedNormal, wi), 0.0) / PI;
        bsdf = albedo / PI;
        path.directionConeSpread.w += 0.25;
    } else {
        float alpha = max(roughness * roughness, 0.0025);
        wi = sampleGgxVndf(orientedNormal, wo, alpha, u0, u1);
        bsdf = evaluateBsdf(materialType, albedo, roughness, orientedNormal, wo, wi, pdf);
        path.directionConeSpread.w += roughness * roughness;
    }
    float cosineOut = max(dot(orientedNormal, wi), 0.0);
    if (pdf <= 0.0 || cosineOut <= 0.0 || any(isnan(bsdf)) || any(isinf(bsdf))) return;
    path.throughputLastPdf.xyz *= bsdf * cosineOut / pdf;
    path.throughputLastPdf.w = pdf;
    path.identity.w &= ~FLAG_LAST_DELTA;
    if (directPrimary) path.identity.w |= FLAG_SUPPRESS_EMITTER;
    enqueueContinuation(nextQueue, path, hitPoint, wi, eventCount, 42u);
}
