#version 460
#include "shading_common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= counters.words[0]) {
        return;
    }
    FrameData frame = frameData();
    bool currentInA = (pc.passIndex & 1u) == 0u;
    bool nextInA = !currentInA;
    PathState path = currentInA ? pathsA.values[index] : pathsB.values[index];
    HitRecord hit = hits.values[index];

    if ((path.meta.w & PATH_INSIDE_GLASS) != 0u && hit.positionT.w > 0.0) {
        vec3 absorption = materials.values[hit.ids.x].absorptionIor.xyz;
        path.throughputEta.xyz *= exp(-absorption * hit.positionT.w);
    }

    if (hit.positionT.w < 0.0) {
        if (path.meta.z == 0u && path.optical.z == INVALID_DOMAIN) {
            analyticValues.values[path.meta.x] = vec4(0.0, 0.0, 0.0, 1.0);
        } else {
            writeBranchResult(path);
        }
        return;
    }

    Material material = materials.values[hit.ids.x];
    uint type = material.typeTexture.x;
    vec3 outwardNormal = normalize(hit.normalFront.xyz);
    vec3 normal = hit.normalFront.w > 0.5 ? outwardNormal : -outwardNormal;
    vec3 view = normalize(-path.directionCone.xyz);
    float coneWidth = path.directionCone.w * max(hit.positionT.w, 0.0);
    vec3 baseColor = sampleBaseColor(hit.ids.x, hit.uvCone.xy, coneWidth);
    float roughness = sampleRoughness(hit.ids.x, hit.uvCone.xy, coneWidth);

    if (type == MATERIAL_EMISSIVE) {
        vec3 emitted = hit.normalFront.w > 0.5 ? material.emissionRoughness.xyz : vec3(0.0);
        float weight = 1.0;
        if ((path.meta.w & PATH_LAST_RESTIR) != 0u && (path.meta.w & PATH_LAST_DELTA) == 0u) {
            weight = 0.0;
        } else if ((path.meta.w & PATH_LAST_DELTA) == 0u && path.radiancePdf.w > 0.0) {
            weight = powerHeuristic(path.radiancePdf.w, emitterDirectionPdf(hit, path));
        }
        path.radiancePdf.xyz += path.throughputEta.xyz * emitted * weight;
        if (path.meta.z == 0u && path.optical.z == INVALID_DOMAIN) {
            analyticValues.values[path.meta.x] = vec4(path.radiancePdf.xyz, 1.0);
        } else {
            if ((path.meta.w & PATH_TERMINAL_VALID) == 0u) {
                establishTerminal(path, hit, normal, vec3(1.0), 0.0, false);
            }
            writeBranchResult(path);
        }
        return;
    }

    if (type == MATERIAL_MIRROR) {
        if (path.optical.z == INVALID_DOMAIN) {
            path.optical.z = DOMAIN_REFLECTION;
        }
        if ((path.meta.w & PATH_TRANSMITTED) == 0u) {
            appendReflectionTransform(path, outwardNormal, hit.positionT.xyz);
        }
        path.optical.x = hashBits(path.optical.x ^ hit.ids.y ^ (path.optical.y * 0x9e3779b9u));
        path.optical.y += 1u;
        path.throughputEta.xyz *= baseColor;
        path.directionCone.xyz = reflect(path.directionCone.xyz, normal);
        path.directionCone.w = coneWidth + 1.0e-5;
        path.originTmin = vec4(hit.positionT.xyz + path.directionCone.xyz * RAY_EPSILON, RAY_EPSILON);
        path.meta.z += 1u;
        path.meta.w |= PATH_LAST_DELTA;
        path.meta.w &= ~PATH_LAST_RESTIR;
        path.radiancePdf.w = 0.0;
        if (!russianRoulette(path, path.meta.y)) {
            writeBranchResult(path);
            return;
        }
        appendPath(path, nextInA);
        return;
    }

    if (type == MATERIAL_DIELECTRIC) {
        bool inside = (path.meta.w & PATH_INSIDE_GLASS) != 0u;
        float etaI = inside ? material.absorptionIor.w : 1.0;
        float etaT = inside ? 1.0 : material.absorptionIor.w;
        float eta = etaI / etaT;
        float cosineI = max(dot(-path.directionCone.xyz, normal), 0.0);
        float sineT2 = eta * eta * max(0.0, 1.0 - cosineI * cosineI);
        bool totalInternalReflection = sineT2 >= 1.0;
        float fresnel = totalInternalReflection ? 1.0 : dielectricFresnel(cosineI, etaI, etaT);
        uint opticalHash = hashBits(path.optical.x ^ hit.ids.y ^
                                    ((inside ? 2u : 1u) * 0x85ebca6bu));

        if ((path.meta.w & PATH_GLASS_SPLIT) == 0u) {
            writeCommonPrefix(path);
            PathState reflected = path;
            reflected.radiancePdf.xyz = vec3(0.0);
            reflected.meta.y = 0u;
            reflected.meta.z += 1u;
            reflected.meta.w |= PATH_GLASS_SPLIT | PATH_LAST_DELTA;
            reflected.meta.w &= ~PATH_LAST_RESTIR;
            reflected.optical.x = opticalHash;
            reflected.optical.y += 1u;
            reflected.optical.z = DOMAIN_GLASS_REFLECTION;
            reflected.throughputEta.xyz *= fresnel;
            reflected.directionCone.xyz = reflect(path.directionCone.xyz, normal);
            reflected.originTmin = vec4(hit.positionT.xyz + reflected.directionCone.xyz * RAY_EPSILON,
                                        RAY_EPSILON);
            if ((reflected.meta.w & PATH_TRANSMITTED) == 0u) {
                appendReflectionTransform(reflected, outwardNormal, hit.positionT.xyz);
            }
            if (russianRoulette(reflected, 0u)) {
                appendPath(reflected, nextInA);
            } else {
                writeBranchResult(reflected);
            }

            if (!totalInternalReflection) {
                PathState transmitted = path;
                transmitted.radiancePdf.xyz = vec3(0.0);
                transmitted.meta.y = 1u;
                transmitted.meta.z += 1u;
                transmitted.meta.w |= PATH_GLASS_SPLIT | PATH_LAST_DELTA | PATH_TRANSMITTED;
                transmitted.meta.w &= ~PATH_LAST_RESTIR;
                if (inside) {
                    transmitted.meta.w &= ~PATH_INSIDE_GLASS;
                } else {
                    transmitted.meta.w |= PATH_INSIDE_GLASS;
                }
                transmitted.optical.x = opticalHash;
                transmitted.optical.y += 1u;
                transmitted.optical.z = DOMAIN_TRANSMISSION;
                transmitted.throughputEta.xyz *= (1.0 - fresnel) * eta * eta;
                transmitted.throughputEta.w = etaT;
                transmitted.directionCone.xyz = refract(path.directionCone.xyz, normal, eta);
                transmitted.originTmin = vec4(hit.positionT.xyz + transmitted.directionCone.xyz * RAY_EPSILON,
                                              RAY_EPSILON);
                if (russianRoulette(transmitted, 1u)) {
                    appendPath(transmitted, nextInA);
                } else {
                    writeBranchResult(transmitted);
                }
            }
            return;
        }

        bool chooseReflection = totalInternalReflection ||
                                randomDimension(path.meta.x, frame.extentFrameFlags.z,
                                                73u + path.meta.z * 5u, path.meta.y) < fresnel;
        path.meta.z += 1u;
        path.meta.w |= PATH_LAST_DELTA;
        path.meta.w &= ~PATH_LAST_RESTIR;
        path.optical.x = opticalHash;
        path.optical.y += 1u;
        if (chooseReflection) {
            path.directionCone.xyz = reflect(path.directionCone.xyz, normal);
            if ((path.meta.w & PATH_TRANSMITTED) == 0u) {
                appendReflectionTransform(path, outwardNormal, hit.positionT.xyz);
            }
        } else {
            path.directionCone.xyz = refract(path.directionCone.xyz, normal, eta);
            path.throughputEta.xyz *= eta * eta;
            path.throughputEta.w = etaT;
            path.meta.w |= PATH_TRANSMITTED;
            path.optical.z = DOMAIN_TRANSMISSION;
            if (inside) {
                path.meta.w &= ~PATH_INSIDE_GLASS;
            } else {
                path.meta.w |= PATH_INSIDE_GLASS;
            }
        }
        path.originTmin = vec4(hit.positionT.xyz + path.directionCone.xyz * RAY_EPSILON, RAY_EPSILON);
        path.radiancePdf.w = 0.0;
        if (!russianRoulette(path, path.meta.y)) {
            writeBranchResult(path);
            return;
        }
        appendPath(path, nextInA);
        return;
    }

    bool specular = type == MATERIAL_ROUGH_METAL;
    if (path.optical.z == INVALID_DOMAIN) {
        path.optical.z = specular ? DOMAIN_OPAQUE_SPECULAR : DOMAIN_OPAQUE_DIFFUSE;
    }
    establishTerminal(path, hit, normal, baseColor, specular ? roughness : 1.0, specular);
    path.meta.w &= ~PATH_PURE_DELTA;

    bool primaryRestir = path.meta.z == 0u &&
                         (path.optical.z == DOMAIN_OPAQUE_DIFFUSE ||
                          path.optical.z == DOMAIN_OPAQUE_SPECULAR);
    vec3 neeContribution = vec3(0.0);
    vec3 neeDirection = vec3(0.0);
    float neeDistance = 0.0;
    if (!primaryRestir) {
        uint dimension = 131u + path.meta.z * 11u;
        uint lightIndex = selectLight(randomDimension(path.meta.x, frame.extentFrameFlags.z,
                                                      dimension, path.meta.y), frame.counts.z);
        vec2 sampleData = vec2(randomDimension(path.meta.x, frame.extentFrameFlags.z,
                                           dimension + 1u, path.meta.y),
                           randomDimension(path.meta.x, frame.extentFrameFlags.z,
                                           dimension + 2u, path.meta.y));
        neeContribution = makeNeeContribution(path, hit, normal, view, baseColor, roughness,
                                              lightIndex, sampleData, neeDirection, neeDistance);
    }

    vec2 xi = vec2(randomDimension(path.meta.x, frame.extentFrameFlags.z,
                                   151u + path.meta.z * 7u, path.meta.y),
                   randomDimension(path.meta.x, frame.extentFrameFlags.z,
                                   152u + path.meta.z * 7u, path.meta.y));
    vec3 outgoing;
    vec3 bsdf;
    float pdf;
    if (!specular) {
        outgoing = makeBasis(normal) * sampleCosineHemisphere(xi);
        float cosine = max(dot(normal, outgoing), 0.0);
        pdf = cosine / PI;
        bsdf = baseColor / PI;
    } else {
        mat3 basis = makeBasis(normal);
        vec3 localView = transpose(basis) * view;
        float alpha = max(roughness * roughness, 0.0004);
        vec3 halfway = basis * sampleGgxVndf(localView, alpha, xi);
        outgoing = reflect(-view, halfway);
        bsdf = evaluateMetal(baseColor, roughness, normal, view, outgoing, pdf);
    }
    float cosine = max(dot(normal, outgoing), 0.0);
    bool canContinue = pdf > 0.0 && cosine > 0.0 && any(greaterThan(bsdf, vec3(0.0)));
    if (canContinue) {
        path.throughputEta.xyz *= bsdf * cosine / pdf;
        path.directionCone.xyz = normalize(outgoing);
        path.directionCone.w = coneWidth + (specular ? roughness * 0.25 : 0.35);
        path.originTmin = vec4(hit.positionT.xyz + normal * RAY_EPSILON, RAY_EPSILON);
        path.radiancePdf.w = pdf;
        path.meta.z += 1u;
        path.meta.w &= ~(PATH_LAST_DELTA | PATH_LAST_RESTIR);
        if (primaryRestir) {
            path.meta.w |= PATH_LAST_RESTIR;
        }
        canContinue = russianRoulette(path, path.meta.y);
    }

    uint targetIndex;
    uint targetType;
    if (canContinue) {
        targetIndex = appendPath(path, nextInA);
        if (targetIndex == 0xffffffffu) {
            writeBranchResult(path);
            targetIndex = path.meta.x * 2u + min(path.meta.y, 1u);
            targetType = 1u;
        } else {
            targetType = 0u;
        }
    } else {
        writeBranchResult(path);
        targetIndex = path.meta.x * 2u + min(path.meta.y, 1u);
        targetType = 1u;
    }
    if (any(greaterThan(neeContribution, vec3(0.0)))) {
        appendShadowTask(hit.positionT.xyz + normal * RAY_EPSILON, neeDirection, neeDistance,
                         neeContribution, targetIndex, targetType, nextInA ? 1u : 0u);
    }
}
