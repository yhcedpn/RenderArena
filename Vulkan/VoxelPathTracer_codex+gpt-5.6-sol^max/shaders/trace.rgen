#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT sceneTlas;

struct HitPayload {
    float distance;
    vec2 barycentric;
    uint triangle;
    uint hit;
    uint frontFace;
};
layout(location = 0) rayPayloadEXT HitPayload payload;

void main() {
    uint index = gl_LaunchIDEXT.x;
    uint queueIndex = pc.params.x;
    uint activeCount = queueCount(queueIndex);
    if (index >= activeCount) return;
    PathState path = readPath(queueIndex, index);
    payload.distance = 0.0;
    payload.barycentric = vec2(0.0);
    payload.triangle = INVALID_INDEX;
    payload.hit = 0u;
    payload.frontFace = 0u;
    float tMinimum = 0.0005;
    if ((path.identity.w & FLAG_PRIMARY_SEGMENT) != 0u) {
        tMinimum = 0.05 / max(dot(path.directionConeSpread.xyz, camera.currentForwardAspect.xyz), 1e-4);
    }
    traceRayEXT(sceneTlas, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0,
                path.originConeWidth.xyz, tMinimum, path.directionConeSpread.xyz, 1.0e5, 0);
    HitState hit;
    hit.distanceBarycentric = vec4(payload.distance, payload.barycentric, float(payload.hit));
    hit.identity = uvec4(payload.triangle, payload.triangle == INVALID_INDEX ? INVALID_INDEX : triangles[payload.triangle].metadata.x,
                         payload.triangle == INVALID_INDEX ? INVALID_INDEX : triangles[payload.triangle].metadata.y,
                         payload.frontFace);
    hitStates[index] = hit;
}
