#version 460
#include "common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint pixel = gl_GlobalInvocationID.x;
    if (pixel >= pixelCount()) return;
    if (globals.flags.w == 0u) {
        guidesHistory0[pixel] = guidesCurrent[pixel];
        reservoirHistory0[pixel] = reservoirSpatial[pixel];
    } else {
        guidesHistory1[pixel] = guidesCurrent[pixel];
        reservoirHistory1[pixel] = reservoirSpatial[pixel];
    }
}
