#version 460
#include "restir_common.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    FrameData frame = frameData();
    uint index = gl_GlobalInvocationID.x;
    uint signalCount = frame.counts.x * DOMAIN_COUNT;
    if (index >= signalCount) {
        return;
    }
    uint domain = index / frame.counts.x;
    uint pixel = index - domain * frame.counts.x;
    uvec2 coordinate = uvec2(pixel % frame.extentFrameFlags.x,
                             pixel / frame.extentFrameFlags.x);
    vec3 current = rawSignals.values[index].xyz;
    BranchResult guide = guidesCurrent.values[index];
    bool valid = (guide.guideIds.w & GUIDE_VALID) != 0u &&
                 (frame.extentFrameFlags.w & FRAME_HISTORY_VALID) != 0u &&
                 (frame.extentFrameFlags.w & FRAME_GLOBAL_RESET) == 0u;
    if (domain == DOMAIN_TRANSMISSION && (frame.extentFrameFlags.w & FRAME_CAMERA_MOVED) != 0u) {
        valid = false;
    }

    uint previousIndex = 0u;
    if (valid) {
        vec2 previousCoordinate;
        if (domain == DOMAIN_TRANSMISSION) {
            previousCoordinate = vec2(coordinate) + frame.jitter.xy - frame.jitter.zw;
        } else {
            vec2 currentProjection = projectCurrent(guide.guidePosition.xyz);
            vec2 previousProjection = projectPrevious(guide.guidePosition.xyz);
            previousCoordinate = vec2(coordinate) + (previousProjection - currentProjection);
        }
        ivec2 rounded = ivec2(round(previousCoordinate));
        if (any(lessThan(rounded, ivec2(0))) ||
            any(greaterThanEqual(rounded, ivec2(frame.extentFrameFlags.xy)))) {
            valid = false;
        } else {
            uint previousPixel = pixelIndex(uvec2(rounded), frame.extentFrameFlags.xy);
            previousIndex = signalIndex(previousPixel, domain, frame.counts.x);
            valid = guideCompatible(guide, guidesPrevious.values[previousIndex]);
        }
    }

    float currentLuminance = luminance(current);
    if (!valid) {
        historyColorCurrent.values[index] = vec4(current, 1.0);
        historyMomentCurrent.values[index] = vec4(currentLuminance,
                                                  currentLuminance * currentLuminance, 0.0, 0.0);
        historyLengthCurrent.values[index] = 1u;
        return;
    }
    uint previousLength = min(historyLengthPrevious.values[previousIndex], 31u);
    uint lengthValue = previousLength + 1u;
    float alpha = max(1.0 / float(lengthValue), 1.0 / 32.0);
    vec3 accumulated = mix(historyColorPrevious.values[previousIndex].xyz, current, alpha);
    vec2 moments = mix(historyMomentPrevious.values[previousIndex].xy,
                       vec2(currentLuminance, currentLuminance * currentLuminance), alpha);
    historyColorCurrent.values[index] = vec4(accumulated, 1.0);
    historyMomentCurrent.values[index] = vec4(moments, 0.0, 0.0);
    historyLengthCurrent.values[index] = lengthValue;
}
