#version 460
#include "restir.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint pixel = gl_GlobalInvocationID.x;
    if (pixel >= pixelCount()) return;
    Reservoir reservoir = reservoirSpatial[pixel];
    RestirSurface surface = surfaceFromShading(shadingPoints[pixel]);
    if (!surface.valid || reservoir.selected.w == 0u || reservoir.weights.y <= 0.0 ||
        reservoir.weights.w <= 0.0)
        return;
    LightEvaluation evaluation = evaluateLightSample(surface, reservoir.selected);
    if (evaluation.target <= 0.0) return;
    vec3 contribution = evaluation.rgb * (reservoir.weights.w / evaluation.target);
    uint slot = atomicAdd(counters.shadowCount, 1u);
    if (slot >= pixelCount()) {
        atomicOr(counters.gpuError, 4u);
        return;
    }
    ShadowTask task;
    task.originTMax = vec4(offsetRay(surface.position, surface.normal, evaluation.direction),
                           max(evaluation.distanceToLight - 2.0e-3, 1.0e-4));
    task.direction = vec4(evaluation.direction, 0.0);
    task.contribution = vec4(contribution, 0.0);
    task.meta = uvec4(pixel, surface.domain, 1u, 0u);
    shadowTasks[slot] = task;
}
