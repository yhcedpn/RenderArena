#version 460
#include "rt_common.glsl"

void main()
{
    FrameData frame = frameData();
    uvec2 extent = frame.extentFrameFlags.xy;
    uvec2 pixel = gl_LaunchIDEXT.xy;
    if (any(greaterThanEqual(pixel, extent))) {
        return;
    }
    uint index = pixelIndex(pixel, extent);
    vec2 samplePosition = (vec2(pixel) + vec2(0.5) + frame.jitter.xy) / vec2(extent);
    vec2 screen = vec2(samplePosition.x * 2.0 - 1.0, 1.0 - samplePosition.y * 2.0);
    vec3 direction = normalize(frame.cameraForward.xyz +
                               frame.cameraRight.xyz * (screen.x * frame.projection.y * frame.projection.x) +
                               frame.cameraUp.xyz * (screen.y * frame.projection.x));
    float nearPlaneDistance = 0.05 / max(dot(direction, frame.cameraForward.xyz), 1.0e-4);

    PathState path;
    path.originTmin = vec4(frame.cameraPosition.xyz, nearPlaneDistance);
    path.directionCone = vec4(direction, 2.0 * frame.projection.x / float(extent.y));
    path.throughputEta = vec4(1.0, 1.0, 1.0, 1.0);
    path.radiancePdf = vec4(0.0);
    path.affine0 = vec4(1.0, 0.0, 0.0, 0.0);
    path.affine1 = vec4(0.0, 1.0, 0.0, 0.0);
    path.affine2 = vec4(0.0, 0.0, 1.0, 0.0);
    path.terminalPosition = vec4(0.0);
    path.terminalNormal = vec4(0.0);
    path.terminalAlbedo = vec4(1.0);
    uint inside = all(greaterThan(frame.cameraPosition.xyz, frame.glassMinimum.xyz)) &&
                  all(lessThan(frame.cameraPosition.xyz, frame.glassMaximum.xyz)) ? PATH_INSIDE_GLASS : 0u;
    path.meta = uvec4(index, 0u, 0u, inside | PATH_PURE_DELTA | PATH_LAST_DELTA);
    path.optical = uvec4(2166136261u, 0u, INVALID_DOMAIN, 0u);
    pathsA.values[index] = path;

    radiancePayload.pathIndex = index;
    radiancePayload.hit = 0u;
    traceRayEXT(sceneTlas, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0,
                path.originTmin.xyz, path.originTmin.w, direction, 1.0e30, 0);
}
