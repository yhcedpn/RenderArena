#version 460
#include "common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= counters.words[2]) {
        return;
    }
    ShadowTask task = shadowTasks.values[index];
    if (shadowVisibility.values[index] == 0u) {
        return;
    }
    if (task.meta.y == 0u) {
        if (task.meta.z != 0u) {
            pathsA.values[task.meta.x].radiancePdf.xyz += task.contribution.xyz;
        } else {
            pathsB.values[task.meta.x].radiancePdf.xyz += task.contribution.xyz;
        }
    } else {
        branchResults.values[task.meta.x].radiance.xyz += task.contribution.xyz;
    }
}
