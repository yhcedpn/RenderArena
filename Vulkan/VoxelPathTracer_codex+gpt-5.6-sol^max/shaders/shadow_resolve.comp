#version 460
#include "common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= counters.shadowCount || shadowResults[index] == 0u) return;
    ShadowTask task = shadowTasks[index];
    if (task.meta.z == 0u) {
        branchOutputs[task.meta.x].radiance.rgb += task.contribution.rgb;
    } else {
        signalsCurrent[task.meta.x].signal[task.meta.y].rgb += task.contribution.rgb;
    }
}
