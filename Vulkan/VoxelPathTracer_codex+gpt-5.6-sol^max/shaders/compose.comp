#version 460
#include "common.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    FrameData frame = frameData();
    uint pixel = gl_GlobalInvocationID.x;
    if (pixel >= frame.counts.x) {
        return;
    }
    vec3 color = analyticValues.values[pixel].xyz;
    for (uint domain = 0u; domain < DOMAIN_COUNT; ++domain) {
        uint index = signalIndex(pixel, domain, frame.counts.x);
        color += atrousB.values[index].xyz * albedoValues.values[index].xyz;
    }
    finalColors.values[pixel] = vec4(max(color, vec3(0.0)), 1.0);
}
