#version 460
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

float kernelWeight(int offset) {
    const float weights[5] = float[5](1.0 / 16.0, 4.0 / 16.0, 6.0 / 16.0,
                                       4.0 / 16.0, 1.0 / 16.0);
    return weights[offset + 2];
}

FilterPixel readFilter(uint index, uint source) {
    return source == 0u ? filterPing[index] : filterPong[index];
}

bool spatialCompatible(Guide a, Guide b, uint domain) {
    if (a.ids.x == 0u || b.ids.x == 0u || guideDomain(a) != domain || guideDomain(b) != domain)
        return false;
    return a.ids.x == b.ids.x && a.ids.y == b.ids.y && a.ids.z == b.ids.z &&
           a.ids.w == b.ids.w && dot(a.normalRoughness.xyz, b.normalRoughness.xyz) > 0.85 &&
           abs(a.normalRoughness.w - b.normalRoughness.w) < 0.12;
}

void main() {
    uvec2 coordinate = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(coordinate, globals.extentCounts.xy))) return;
    uint pixel = coordinate.y * globals.extentCounts.x + coordinate.x;
    uint source = pushData.u0.x;
    int stepWidth = int(pushData.u0.y);
    FilterPixel centerPixel = readFilter(pixel, source);
    FilterPixel filteredResult;

    for (uint domain = 0u; domain < DOMAIN_COUNT; ++domain) {
        Guide centerGuide = findGuide(guidesCurrent[pixel], domain);
        vec4 center = centerPixel.valueVariance[domain];
        if (centerGuide.ids.x == 0u) {
            filteredResult.valueVariance[domain] = center;
            continue;
        }
        float sigma = sqrt(max(center.w, 0.0)) + 1.0e-3;
        float centerLuminance = luminance(center.rgb);
        vec3 valueSum = vec3(0.0);
        float varianceNumerator = 0.0;
        float weightSum = 0.0;
        for (int ky = -2; ky <= 2; ++ky) {
            for (int kx = -2; kx <= 2; ++kx) {
                ivec2 neighborCoordinate = ivec2(coordinate) +
                                           ivec2(kx * stepWidth, ky * stepWidth);
                if (any(lessThan(neighborCoordinate, ivec2(0))) ||
                    any(greaterThanEqual(neighborCoordinate,
                                         ivec2(globals.extentCounts.xy))))
                    continue;
                uint neighborPixel = uint(neighborCoordinate.y) * globals.extentCounts.x +
                                     uint(neighborCoordinate.x);
                Guide neighborGuide = findGuide(guidesCurrent[neighborPixel], domain);
                if (!spatialCompatible(centerGuide, neighborGuide, domain)) continue;
                vec4 neighbor = readFilter(neighborPixel, source).valueVariance[domain];
                float base = kernelWeight(kx) * kernelWeight(ky);
                // Position is measured in world units. The scale grows with wavelet
                // step and projected footprint, rather than with a scene/material ID.
                float positionScale = 0.08 * float(stepWidth) +
                                      0.003 * max(centerGuide.positionDepth.w,
                                                  neighborGuide.positionDepth.w);
                float positionWeight = exp(-distance(centerGuide.positionDepth.xyz,
                                                     neighborGuide.positionDepth.xyz) /
                                           max(positionScale, 1.0e-3));
                float normalWeight = pow(max(dot(centerGuide.normalRoughness.xyz,
                                                 neighborGuide.normalRoughness.xyz),
                                             0.0),
                                         32.0);
                float roughnessWeight = exp(-abs(centerGuide.normalRoughness.w -
                                                 neighborGuide.normalRoughness.w) /
                                             0.05);
                float colorWeight = exp(-abs(centerLuminance - luminance(neighbor.rgb)) /
                                        (4.0 * sigma));
                float weight = base * positionWeight * normalWeight * roughnessWeight *
                               colorWeight;
                valueSum += neighbor.rgb * weight;
                varianceNumerator += neighbor.w * weight * weight;
                weightSum += weight;
            }
        }
        if (weightSum > 0.0) {
            filteredResult.valueVariance[domain] =
                vec4(valueSum / weightSum,
                     varianceNumerator / max(weightSum * weightSum, 1.0e-20));
        } else {
            filteredResult.valueVariance[domain] = center;
        }
    }

    if (source == 0u)
        filterPong[pixel] = filteredResult;
    else
        filterPing[pixel] = filteredResult;
}
