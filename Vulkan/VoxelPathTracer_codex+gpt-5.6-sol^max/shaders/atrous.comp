#version 460
#include "common.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

float kernelWeight(int offset)
{
    const float kernel[5] = float[5](1.0 / 16.0, 4.0 / 16.0, 6.0 / 16.0,
                                      4.0 / 16.0, 1.0 / 16.0);
    return kernel[offset + 2];
}

bool opticalCompatible(BranchResult center, BranchResult sampleGuide)
{
    if ((center.guideIds.w & GUIDE_VALID) == 0u ||
        (sampleGuide.guideIds.w & GUIDE_VALID) == 0u) {
        return false;
    }
    return center.guideIds.xyz == sampleGuide.guideIds.xyz &&
           dot(center.guideNormal.xyz, sampleGuide.guideNormal.xyz) >= 0.75 &&
           abs(center.guideNormal.w - sampleGuide.guideNormal.w) <= 0.2;
}

void main()
{
    FrameData frame = frameData();
    uint index = gl_GlobalInvocationID.x;
    uint signalCount = frame.counts.x * DOMAIN_COUNT;
    if (index >= signalCount) {
        return;
    }
    uint domain = index / frame.counts.x;
    uint pixel = index - domain * frame.counts.x;
    uvec2 extent = frame.extentFrameFlags.xy;
    ivec2 coordinate = ivec2(int(pixel % extent.x), int(pixel / extent.x));
    uint stepSize = 1u << pc.passIndex;
    vec4 centerValue = (pc.passIndex & 1u) == 0u ? atrousA.values[index] : atrousB.values[index];
    BranchResult centerGuide = guidesCurrent.values[index];
    float centerLuminance = luminance(centerValue.xyz);
    float sigma = 4.0 * sqrt(max(centerValue.w, 1.0e-8)) + 1.0e-4;
    vec3 colorSum = vec3(0.0);
    float varianceSum = 0.0;
    float weightSum = 0.0;
    for (int y = -2; y <= 2; ++y) {
        for (int x = -2; x <= 2; ++x) {
            ivec2 sampleCoordinate = coordinate + ivec2(x, y) * int(stepSize);
            if (any(lessThan(sampleCoordinate, ivec2(0))) ||
                any(greaterThanEqual(sampleCoordinate, ivec2(extent)))) {
                continue;
            }
            uint samplePixel = pixelIndex(uvec2(sampleCoordinate), extent);
            uint sampleIndex = signalIndex(samplePixel, domain, frame.counts.x);
            BranchResult sampleGuide = guidesCurrent.values[sampleIndex];
            if (!opticalCompatible(centerGuide, sampleGuide)) {
                continue;
            }
            vec4 sampleValue = (pc.passIndex & 1u) == 0u ? atrousA.values[sampleIndex]
                                                         : atrousB.values[sampleIndex];
            float baseWeight = kernelWeight(x) * kernelWeight(y);
            float positionScale = 0.08 + 0.015 * max(centerGuide.guidePosition.w, 0.0);
            float positionWeight = exp(-distance(centerGuide.guidePosition.xyz,
                                                 sampleGuide.guidePosition.xyz) /
                                       (positionScale * float(stepSize) + 1.0e-5));
            float normalWeight = pow(max(dot(centerGuide.guideNormal.xyz,
                                             sampleGuide.guideNormal.xyz), 0.0), 32.0);
            float roughnessWeight = exp(-abs(centerGuide.guideNormal.w - sampleGuide.guideNormal.w) /
                                        0.08);
            float luminanceWeight = exp(-abs(centerLuminance - luminance(sampleValue.xyz)) / sigma);
            float weight = baseWeight * positionWeight * normalWeight * roughnessWeight * luminanceWeight;
            colorSum += sampleValue.xyz * weight;
            varianceSum += sampleValue.w * weight * weight;
            weightSum += weight;
        }
    }
    vec4 outputValue = centerValue;
    if (weightSum > 0.0) {
        outputValue = vec4(colorSum / weightSum, varianceSum / (weightSum * weightSum));
    }
    if ((pc.passIndex & 1u) == 0u) {
        atrousB.values[index] = outputValue;
    } else {
        atrousA.values[index] = outputValue;
    }
}
