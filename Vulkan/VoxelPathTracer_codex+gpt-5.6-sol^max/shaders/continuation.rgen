#version 460
#extension GL_EXT_ray_tracing : require
#include "common.glsl"

layout(set = 0, binding = 30) uniform accelerationStructureEXT sceneTlas;
layout(location = 0) rayPayloadEXT uint payloadIndex;

void main() {
    uint index = gl_LaunchIDEXT.x;
    uint inputQueue = pushData.u0.x;
    uint count = counters.queueCount[inputQueue];
    if (index >= count) return;
    PathState path = inputQueue == 0u ? pathsA[index] : pathsB[index];
    payloadIndex = index;
    traceRayEXT(sceneTlas, gl_RayFlagsOpaqueEXT, 0xffu, 0u, 0u, 0u,
                path.originCone.xyz, 1.0e-4, path.directionSpread.xyz, 1.0e4, 0);
}
