#version 460
#include "rt_common.glsl"

void main()
{
    uint index = gl_LaunchIDEXT.x;
    uint count = counters.words[0];
    if (index >= count) {
        return;
    }
    PathState path = (pc.passIndex & 1u) == 0u ? pathsA.values[index] : pathsB.values[index];
    radiancePayload.pathIndex = index;
    radiancePayload.hit = 0u;
    traceRayEXT(sceneTlas, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0,
                path.originTmin.xyz, path.originTmin.w, path.directionCone.xyz, 1.0e30, 0);
}
