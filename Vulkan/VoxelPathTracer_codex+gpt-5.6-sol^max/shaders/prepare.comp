#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint pixel = gl_GlobalInvocationID.x;
    if (pixel == 0u) {
        countA = pixelCount();
        countB = 0u;
        shadowCount = 0u;
        overflowFlag = 0u;
    }
    if (pixel >= pixelCount()) return;

    uvec2 coordinate = uvec2(pixel % camera.frame.x, pixel / camera.frame.x);
    vec2 samplePosition = vec2(coordinate) + vec2(0.5) + camera.jitterPixels.xy;
    vec2 ndc = samplePosition / vec2(camera.frame.xy) * 2.0 - 1.0;
    vec3 direction = normalize(camera.currentForwardAspect.xyz +
                               ndc.x * camera.currentPositionTanHalfFov.w * camera.currentForwardAspect.w *
                                   camera.currentRight.xyz +
                               ndc.y * camera.currentPositionTanHalfFov.w * camera.currentUp.xyz);

    PathState path;
    path.originConeWidth = vec4(camera.currentPositionTanHalfFov.xyz, 0.0);
    path.directionConeSpread = vec4(direction,
        2.0 * camera.currentPositionTanHalfFov.w / float(max(camera.frame.y, 1u)));
    path.throughputLastPdf = vec4(1.0, 1.0, 1.0, 0.0);
    uint flags = FLAG_PRIMARY_SEGMENT | FLAG_LAST_DELTA;
    bool insideGlass = all(greaterThan(camera.currentPositionTanHalfFov.xyz, vec3(7.0, 0.125, 7.0))) &&
                       all(lessThan(camera.currentPositionTanHalfFov.xyz, vec3(9.0, 2.125, 9.0)));
    if (insideGlass) flags |= FLAG_INSIDE_MEDIUM;
    path.identity = uvec4(pixel, pixel * 2u, 0u, flags);
    // Optical identity is path-topology identity, not pixel identity. Keeping
    // the pixel hash here would reject every valid cross-pixel reprojection.
    path.optical = uvec4(0x811c9dc5u, 0u, DOMAIN_UNCLASSIFIED, insideGlass ? pc.extra.z : INVALID_INDEX);
    path.reflectionRow0 = vec4(1.0, 0.0, 0.0, 0.0);
    path.reflectionRow1 = vec4(0.0, 1.0, 0.0, 0.0);
    path.reflectionRow2 = vec4(0.0, 0.0, 1.0, 0.0);
    pathsA[pixel] = path;

    uint branchBase = currentBranchBase() + pixel * 2u;
    BranchRecord empty;
    empty.radiance = vec4(0.0);
    empty.guide = invalidGuide();
    empty.metadata = uvec4(DOMAIN_UNCLASSIFIED, 0u, 0u, 0u);
    branchRecords[branchBase] = empty;
    branchRecords[branchBase + 1u] = empty;
}
