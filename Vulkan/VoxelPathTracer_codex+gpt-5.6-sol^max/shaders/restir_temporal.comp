#version 460
#include "restir_common.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    FrameData frame = frameData();
    uint pixel = gl_GlobalInvocationID.x;
    if (pixel >= frame.counts.x) {
        return;
    }
    Reservoir current = reservoirInitial.values[pixel];
    if (current.weights.w == 0.0) {
        reservoirTemporal.values[pixel] = current;
        return;
    }
    HitRecord hit = hits.values[pixel];
    PathState path = pathsA.values[pixel];
    uint domain = primaryDomain(hit.ids.x);
    BranchResult currentGuide = guidesCurrent.values[signalIndex(pixel, domain, frame.counts.x)];
    bool historyAllowed = (frame.extentFrameFlags.w & FRAME_HISTORY_VALID) != 0u &&
                          (frame.extentFrameFlags.w & FRAME_GLOBAL_RESET) == 0u;
    Reservoir previous = emptyReservoir();
    BranchResult previousGuide;
    previousGuide.guideIds.w = 0u;
    if (historyAllowed) {
        vec2 currentProjection = projectCurrent(currentGuide.guidePosition.xyz);
        vec2 previousProjection = projectPrevious(currentGuide.guidePosition.xyz);
        uvec2 currentCoordinate = uvec2(pixel % frame.extentFrameFlags.x,
                                        pixel / frame.extentFrameFlags.x);
        vec2 reprojected = vec2(currentCoordinate) + (previousProjection - currentProjection);
        ivec2 previousPixel = ivec2(round(reprojected));
        if (all(greaterThanEqual(previousPixel, ivec2(0))) &&
            all(lessThan(previousPixel, ivec2(frame.extentFrameFlags.xy)))) {
            uint previousIndex = pixelIndex(uvec2(previousPixel), frame.extentFrameFlags.xy);
            previousGuide = guidesPrevious.values[signalIndex(previousIndex, domain, frame.counts.x)];
            if (guideCompatible(currentGuide, previousGuide)) {
                previous = reservoirPrevious.values[previousIndex];
            }
        }
    }

    Reservoir outputReservoir = emptyReservoir();
    float currentTarget;
    float currentProposal;
    vec3 direction;
    float distanceToLight;
    evaluateDirectAtHit(hit, path, current.ids.x, current.sampleData.xy, currentTarget, currentProposal,
                        direction, distanceToLight);
    float currentWeight = currentTarget * current.weights.z * current.weights.y;
    reservoirUpdate(outputReservoir, current.ids.x, current.sampleData.xy, currentTarget, currentProposal,
                    currentWeight, randomDimension(pixel, frame.extentFrameFlags.z, 31u, 0u));
    float currentM = current.weights.y;
    float previousM = 0.0;
    if (previous.weights.w != 0.0 && previous.weights.y > 0.0) {
        previousM = min(previous.weights.y, max(32.0 - currentM, 0.0));
        float target;
        float proposal;
        evaluateDirectAtHit(hit, path, previous.ids.x, previous.sampleData.xy, target, proposal,
                            direction, distanceToLight);
        float previousWeight = target * previous.weights.z * previousM;
        reservoirUpdate(outputReservoir, previous.ids.x, previous.sampleData.xy, target, proposal, previousWeight,
                        randomDimension(pixel, frame.extentFrameFlags.z, 32u, 0u));
    }
    float selectedTarget;
    float selectedProposal;
    evaluateDirectAtHit(hit, path, outputReservoir.ids.x, outputReservoir.sampleData.xy, selectedTarget, selectedProposal,
                        direction, distanceToLight);
    float supportM = selectedTarget > 0.0 ? currentM : 0.0;
    if (previousM > 0.0 && targetAtGuide(previousGuide, outputReservoir.ids.x, outputReservoir.sampleData.xy,
                                         frame.previousPosition.xyz) > 0.0) {
        supportM += previousM;
    }
    outputReservoir.sampleData.z = selectedTarget;
    outputReservoir.sampleData.w = selectedProposal;
    outputReservoir.weights.y = min(supportM, 32.0);
    outputReservoir.weights.z = supportM > 0.0 && selectedTarget > 0.0
                           ? outputReservoir.weights.x / (supportM * selectedTarget)
                           : 0.0;
    outputReservoir.weights.w = outputReservoir.weights.z > 0.0 ? 1.0 : 0.0;
    if (supportM > 32.0) {
        outputReservoir.weights.x *= 32.0 / supportM;
    }
    reservoirTemporal.values[pixel] = outputReservoir;
}
