#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= shadowCount || shadowResults[index] == 0u) return;
    ShadowTask task = shadowTasks[index];
    uint branchIndex = currentBranchBase() + task.identity.x;
    BranchRecord record = branchRecords[branchIndex];
    record.radiance.xyz += task.contribution.xyz;
    branchRecords[branchIndex] = record;
}
