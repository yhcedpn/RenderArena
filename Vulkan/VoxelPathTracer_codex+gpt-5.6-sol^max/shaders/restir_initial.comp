#version 460
#include "restir.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint pixel = gl_GlobalInvocationID.x;
    if (pixel >= pixelCount()) return;
    RestirSurface surface = surfaceFromShading(shadingPoints[pixel]);
    Reservoir resultReservoir = emptyReservoir();
    if (!surface.valid) {
        reservoirInitial[pixel] = resultReservoir;
        return;
    }
    uint frame = floatBitsToUint(globals.cameraPositionFrame.w);
    float weightSum = 0.0;
    float selectedTarget = 0.0;
    uvec4 selected = uvec4(0u);
    for (uint candidate = 0u; candidate < 4u; ++candidate) {
        float lightXi = randomFloat(pixel, frame, 48u + candidate * 3u, 0u);
        float r1 = randomFloat(pixel, frame, 49u + candidate * 3u, 0u);
        float r2 = randomFloat(pixel, frame, 50u + candidate * 3u, 0u);
        uint lightIndex = restirSampleLight(lightXi);
        float su = sqrt(r1);
        uvec4 candidateSample = uvec4(lightIndex, floatBitsToUint(su * (1.0 - r2)),
                                      floatBitsToUint(su * r2), 1u);
        LightEvaluation evaluation = evaluateLightSample(surface, candidateSample);
        float weight = evaluation.proposalArea > 0.0
                           ? evaluation.target / evaluation.proposalArea
                           : 0.0;
        if (!isnan(weight) && weight > 0.0) {
            weightSum += weight;
            if (randomFloat(pixel, frame, 96u + candidate, 0u) < weight / weightSum) {
                selected = candidateSample;
                selectedTarget = evaluation.target;
            }
        }
    }
    if (selected.w != 0u && selectedTarget > 0.0 && weightSum > 0.0) {
        resultReservoir.selected = selected;
        resultReservoir.weights = vec4(weightSum, selectedTarget, 4.0,
                                       weightSum / (4.0 * selectedTarget));
    }
    reservoirInitial[pixel] = resultReservoir;
}
