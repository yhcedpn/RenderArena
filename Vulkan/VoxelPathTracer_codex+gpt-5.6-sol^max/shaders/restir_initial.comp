#version 460
#include "restir_common.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    FrameData frame = frameData();
    uint pixel = gl_GlobalInvocationID.x;
    if (pixel >= frame.counts.x) {
        return;
    }
    HitRecord hit = hits.values[pixel];
    Reservoir reservoir = emptyReservoir();
    if (hit.positionT.w >= 0.0) {
        uint type = materials.values[hit.ids.x].typeTexture.x;
        if (type == MATERIAL_DIFFUSE || type == MATERIAL_ROUGH_METAL) {
            for (uint candidate = 0u; candidate < 4u; ++candidate) {
                uint dimension = 11u + candidate * 4u;
                uint lightIndex = selectLight(randomDimension(pixel, frame.extentFrameFlags.z, dimension, 0u),
                                               frame.counts.z);
                vec2 sampleData = vec2(randomDimension(pixel, frame.extentFrameFlags.z, dimension + 1u, 0u),
                                   randomDimension(pixel, frame.extentFrameFlags.z, dimension + 2u, 0u));
                float target;
                float proposal;
                vec3 direction;
                float distanceToLight;
                evaluateDirectAtHit(hit, pathsA.values[pixel], lightIndex, sampleData, target, proposal,
                                    direction, distanceToLight);
                float weight = proposal > 0.0 ? target / proposal : 0.0;
                reservoirUpdate(reservoir, lightIndex, sampleData, target, proposal, weight,
                                randomDimension(pixel, frame.extentFrameFlags.z, dimension + 3u, 0u));
            }
            reservoir.weights.y = 4.0;
            if (reservoir.weights.x > 0.0 && reservoir.sampleData.z > 0.0) {
                reservoir.weights.z = reservoir.weights.x / (4.0 * reservoir.sampleData.z);
                reservoir.weights.w = 1.0;
            }
        }
    }
    reservoirInitial.values[pixel] = reservoir;
}
