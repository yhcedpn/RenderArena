#version 460
#include "restir_common.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    FrameData frame = frameData();
    uint pixel = gl_GlobalInvocationID.x;
    if (pixel >= frame.counts.x) {
        return;
    }
    Reservoir center = reservoirTemporal.values[pixel];
    if (center.weights.w == 0.0) {
        reservoirSpatial.values[pixel] = center;
        return;
    }
    HitRecord hit = hits.values[pixel];
    PathState path = pathsA.values[pixel];
    uint domain = primaryDomain(hit.ids.x);
    BranchResult centerGuide = guidesCurrent.values[signalIndex(pixel, domain, frame.counts.x)];
    uvec2 extent = frame.extentFrameFlags.xy;
    uvec2 centerPixel = uvec2(pixel % extent.x, pixel / extent.x);
    Reservoir outputReservoir = emptyReservoir();
    float supportM[5];
    Reservoir sources[5];
    BranchResult sourceGuides[5];
    bool included[5];
    for (uint source = 0u; source < 5u; ++source) {
        included[source] = false;
        supportM[source] = 0.0;
    }
    sources[0] = center;
    sourceGuides[0] = centerGuide;
    included[0] = true;
    supportM[0] = center.weights.y;
    for (uint neighbor = 0u; neighbor < 4u; ++neighbor) {
        float angle = 2.0 * PI * randomDimension(pixel, frame.extentFrameFlags.z,
                                                 41u + neighbor * 2u, 0u);
        float radius = 1.0 + 7.0 * randomDimension(pixel, frame.extentFrameFlags.z,
                                                   42u + neighbor * 2u, 0u);
        ivec2 offset = ivec2(round(vec2(cos(angle), sin(angle)) * radius));
        ivec2 coordinate = ivec2(centerPixel) + offset;
        if (any(lessThan(coordinate, ivec2(0))) || any(greaterThanEqual(coordinate, ivec2(extent)))) {
            continue;
        }
        uint neighborPixel = pixelIndex(uvec2(coordinate), extent);
        BranchResult guide = guidesCurrent.values[signalIndex(neighborPixel, domain, frame.counts.x)];
        Reservoir sourceReservoir = reservoirTemporal.values[neighborPixel];
        if (!guideCompatible(centerGuide, guide) || sourceReservoir.weights.w == 0.0) {
            continue;
        }
        sources[neighbor + 1u] = sourceReservoir;
        sourceGuides[neighbor + 1u] = guide;
        included[neighbor + 1u] = true;
        supportM[neighbor + 1u] = sourceReservoir.weights.y;
    }

    vec3 direction;
    float distanceToLight;
    for (uint source = 0u; source < 5u; ++source) {
        if (!included[source]) {
            continue;
        }
        float target;
        float proposal;
        evaluateDirectAtHit(hit, path, sources[source].ids.x, sources[source].sampleData.xy,
                            target, proposal, direction, distanceToLight);
        float weight = target * sources[source].weights.z * supportM[source];
        reservoirUpdate(outputReservoir, sources[source].ids.x, sources[source].sampleData.xy, target, proposal,
                        weight, randomDimension(pixel, frame.extentFrameFlags.z, 53u + source, 0u));
    }
    float selectedTarget;
    float selectedProposal;
    evaluateDirectAtHit(hit, path, outputReservoir.ids.x, outputReservoir.sampleData.xy, selectedTarget, selectedProposal,
                        direction, distanceToLight);
    float correctedM = 0.0;
    for (uint source = 0u; source < 5u; ++source) {
        if (included[source] && targetAtGuide(sourceGuides[source], outputReservoir.ids.x, outputReservoir.sampleData.xy,
                                              frame.cameraPosition.xyz) > 0.0) {
            correctedM += supportM[source];
        }
    }
    outputReservoir.sampleData.z = selectedTarget;
    outputReservoir.sampleData.w = selectedProposal;
    outputReservoir.weights.z = correctedM > 0.0 && selectedTarget > 0.0
                           ? outputReservoir.weights.x / (correctedM * selectedTarget)
                           : 0.0;
    outputReservoir.weights.w = outputReservoir.weights.z > 0.0 ? 1.0 : 0.0;
    if (correctedM > 32.0) {
        outputReservoir.weights.x *= 32.0 / correctedM;
    }
    outputReservoir.weights.y = min(correctedM, 32.0);
    reservoirSpatial.values[pixel] = outputReservoir;
}
