#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "restir.glsl"
layout(local_size_x=64) in;
void main() {
    uint i=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*64u+gl_LocalInvocationID.x;
    uint n=pc.width*pc.height; if (i>=n) return;
    Guide guide=Guide(vec3(0),0u,vec3(0),0u,vec3(0),0.0,vec3(0),0xffffffffu);
    Path path=readPath(0u,i); Hit hit=hits[i];
    if (hit.triangle!=0xffffffffu) {
        TriangleInfo triangle=triangles[hit.triangle]; Material material=materials[triangle.material];
        if (material.type<=1u) {
            Vertex a=vertices[3u*hit.triangle],b=vertices[3u*hit.triangle+1u],c=vertices[3u*hit.triangle+2u];
            float w=1.0-hit.bary.x-hit.bary.y; vec2 uv=a.uv*w+b.uv*hit.bary.x+c.uv*hit.bary.y;
            float footprint=path.footprint+path.cone*hit.distance;
            float lod=max(0.0,log2(max(1.0,footprint*float(textureSize(baseTexture,0).x))));
            guide.position=path.origin+path.direction*hit.distance; guide.surface=triangle.surface; guide.normal=a.normal;
            guide.material=triangle.material; guide.albedo=textureLod(baseTexture,vec3(uv,float(triangle.material)),lod).rgb;
            guide.roughness=textureLod(roughTexture,vec3(uv,float(triangle.material)),lod).r; guide.view=-path.direction; guide.type=material.type;
        }
    }
    guides[(pc.frame&1u)*n+i]=guide;
    Reservoir r=emptyReservoir();
    if (guide.type<=1u && pc.lightCount>0u && pc.lightPower>0.0) {
        uint rng=hashValue(i^hashValue(pc.frame+0x4cf5ad43u));
        for (uint candidate=0u;candidate<4u;++candidate) {
            float choice=randomValue(rng)*pc.lightPower; uint light=0u;
            while (light+1u<pc.lightCount && choice>=lights[light].cumulativePower) ++light;
            float u=randomValue(rng),v=randomValue(rng),root=sqrt(u); vec2 bary=vec2(root*(1.0-v),root*v);
            float target=luminance(targetColor(guide,light,bary)),proposal=lightAreaPdf(light);
            float weight=proposal>0.0 ? target/proposal : 0.0;
            r.M++; r.weightSum+=weight;
            if (weight>0.0 && randomValue(rng)*r.weightSum<weight) { r.light=light; r.bary=bary; r.valid=1u; }
        }
        if (r.valid!=0u) { float target=luminance(targetColor(guide,r.light,r.bary)); if (target>0.0) r.W=r.weightSum/(float(r.M)*target); }
    }
    reservoirs[i]=r;
}
