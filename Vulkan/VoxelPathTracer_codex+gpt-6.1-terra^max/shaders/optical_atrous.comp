#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "restir.glsl"
#include "optics.glsl"
#include "optical_filter.glsl"
layout(local_size_x=64) in;
void main() {
    uint index=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*64u+gl_LocalInvocationID.x;
    uint n=pc.width*pc.height; if (index>=2u*n) return;
    uint pixel=index/2u,branch=index&1u,phase=pc.frame&1u,at=opticalIndex(phase,branch,pixel);
    uint inputIndex=(pc.inputQueue*2u+branch)*n+pixel,outputIndex=((1u-pc.inputQueue)*2u+branch)*n+pixel;
    History h=opticalHistories[at]; FilterValue center=opticalFilters[inputIndex];
    if (h.valid==0u) { opticalFilters[outputIndex]=center; return; }
    Guide guide=opticalGuide(phase,branch,pixel); OpticalMeta meta=opticalMetadata[at];
    ivec2 p=ivec2(int(pixel%pc.width),int(pixel/pc.width));
    const float kernel[5]=float[5](1.0,4.0,6.0,4.0,1.0); int stride=1<<int(pc.mode);
    vec3 sum=vec3(0); float total=0.0,varianceSum=0.0,centerLuma=luminance(center.color);
    float depthScale=0.03+2.0*length(guide.position-pc.position)*float(stride)/float(pc.height);
    for (int y=-2;y<=2;++y) for (int x=-2;x<=2;++x) {
        ivec2 q=p+ivec2(x,y)*stride;
        if (any(lessThan(q,ivec2(0))) || any(greaterThanEqual(q,ivec2(pc.width,pc.height)))) continue;
        uint j=uint(q.y)*pc.width+uint(q.x),oi=opticalIndex(phase,branch,j);
        History otherHistory=opticalHistories[oi]; Guide other=opticalGuide(phase,branch,j); OpticalMeta om=opticalMetadata[oi];
        if (otherHistory.valid==0u || !sameOpticalChain(meta,at,om,oi) ||
            other.type!=guide.type || other.material!=guide.material || other.surface!=guide.surface ||
            (dot(other.normal,other.view)>=0.0)!=(dot(guide.normal,guide.view)>=0.0)) continue;
        float normalWeight=pow(max(0.0,dot(guide.normal,other.normal)),32.0);
        float depthWeight=exp(-abs(dot(other.position-guide.position,guide.normal))/depthScale);
        float roughWeight=exp(-abs(other.roughness-guide.roughness)/0.2);
        FilterValue sampleValue=opticalFilters[(pc.inputQueue*2u+branch)*n+j];
        float sigma=0.01+4.0*sqrt(max(0.0,center.variance+sampleValue.variance));
        float weight=kernel[x+2]*kernel[y+2]*normalWeight*depthWeight*roughWeight*exp(-abs(luminance(sampleValue.color)-centerLuma)/sigma);
        sum+=weight*sampleValue.color; varianceSum+=weight*weight*sampleValue.variance; total+=weight;
    }
    opticalFilters[outputIndex]=total>0.0 ? FilterValue(sum/total,varianceSum/(total*total)) : center;
}
