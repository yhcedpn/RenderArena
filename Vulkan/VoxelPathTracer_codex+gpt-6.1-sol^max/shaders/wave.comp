    if(pc.mode==2u){shade(i);return;}
    if(pc.mode==3u){if(i!=0u)return;uint cap=uint(frame.limits.z),n=counters[pc.queue],s=counters[2];counters[4]=min(max(n,1u),cap);counters[5]=(max(n,1u)+cap-1u)/cap;counters[6]=1;
        counters[8]=min(max(s,1u),cap);counters[9]=(max(s,1u)+cap-1u)/cap;counters[10]=1;uint groups=(n+63u)/64u,gw=min(max(groups,1u),uint(frame.limits.w));counters[12]=gw;counters[13]=(max(groups,1u)+gw-1u)/gw;counters[14]=1;return;}
