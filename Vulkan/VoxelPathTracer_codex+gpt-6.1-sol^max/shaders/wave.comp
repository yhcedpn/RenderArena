            // actual/geometry/aux.zw 验证这条玻璃分支的独立终端，不能拿主 hit 冒充终端。
            Guide rooted=guides[slot];rooted.ids.x=1u;rooted.actual=vec4(h.position.xyz,p.previous.w);rooted.geometry=vec4(n,h.normal.w);rooted.view=vec4(-p.direction.xyz,0);
