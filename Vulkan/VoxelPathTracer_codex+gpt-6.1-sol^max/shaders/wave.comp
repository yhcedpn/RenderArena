void saveGuide(inout Path p,Hit h,vec3 albedo,float rough,uint kind){
    uint slot=p.id.x*3u+p.id.y;
    vec3 n=dot(h.normal.xyz,p.direction.xyz)<0.0?h.normal.xyz:-h.normal.xyz;
    if((p.flags.y&4u)!=0u){
        if((p.flags.y&16u)!=0u){
