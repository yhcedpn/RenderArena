void main(){uint i=workID(),N=pixels();
    if(pc.mode==0u){if(i>=N)return;for(uint b=0u;b<3u;++b){uint s=i*3u+b;signals[s*2u]=vec4(0);signals[s*2u+1u]=vec4(0);guides[s]=Guide(vec4(0),vec4(0),vec4(0),vec4(0),vec4(0),vec4(0),uvec4(0),uvec4(0),vec4(0));}
        vec2 xy=vec2(i%frame.extent.x,i/frame.extent.x)+0.5+frame.jitter.xy;vec2 ndc=xy/vec2(frame.extent.xy)*2.0-1.0;vec3 d=normalize(frame.forward.xyz+frame.right.xyz*(ndc.x*frame.right.w)-frame.up.xyz*(ndc.y*frame.up.w));
        bool inside=all(greaterThan(frame.eye.xyz,vec3(7,0.125,7)))&&all(lessThan(frame.eye.xyz,vec3(9,2.125,9)));
        Path p=Path(vec4(frame.eye.xyz,0.05/dot(d,frame.forward.xyz)),vec4(d,2.0*frame.up.w/float(frame.extent.y)),vec4(1,1,1,0),vec4(0),uvec4(i,0,0,inside?1u:0u),uvec4(0),vec4(1,0,0,0),vec4(0,1,0,0),vec4(0,0,1,0),vec4(0));qa[i]=p;
        if(i==0u){counters[0]=N;counters[1]=0;counters[2]=0;}return;}
