    if(s2>=1.0){F=1;transmitted=vec3(0);return;}float ct=sqrt(1.0-s2),ni=inside?ior:1.0,nt=inside?1.0:ior;
    float rs=(ni*c-nt*ct)/(ni*c+nt*ct),rp=(nt*c-ni*ct)/(nt*c+ni*ct);F=0.5*(rs*rs+rp*rp);transmitted=normalize(eta*direction+(eta*c-ct)*n);
