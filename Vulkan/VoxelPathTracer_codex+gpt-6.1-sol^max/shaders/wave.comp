}
void continuePath(Path p,vec3 direction,vec3 point,vec3 geom,inout uint rng){
    p.origin=vec4(offsetRay(point,geom,direction),0);p.direction.xyz=direction;p.id.z++;
    if(p.id.z>=4u){float survival=clamp(max3(p.beta.xyz),0.05,0.95);if(rnd(rng)>=survival)return;p.beta.xyz/=survival;}
    enqueue(p);
}
void dielectric(vec3 direction,vec3 geometric,bool inside,float ior,out float F,out vec3 transmitted){
