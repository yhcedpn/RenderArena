vec4 filterRead(uint s){return (pc.iteration&1u)==0u?filterA[s]:filterB[s];}
void atrous(uint s){Guide g=guides[s];vec4 center=filterRead(s);if(g.ids.x==0u||g.albedo.w>=3.0){if((pc.iteration&1u)==0u)filterB[s]=center;else filterA[s]=center;return;}
