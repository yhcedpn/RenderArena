void restirTemporal(uint i){Guide g=guides[i*3u];Reservoir src[5];Guide gs[5];src[0]=initialR[i];gs[0]=g;uint count=1u;
    if(frame.control.x==0u&&restirGuide(g)){int old=reproject(g);if(old>=0&&compatible(g,oldGuides[uint(old)*3u],false)&&restirGuide(oldGuides[uint(old)*3u])){src[1]=oldR[old];gs[1]=oldGuides[uint(old)*3u];count=2u;}}
    uint rng=hash32(i^hash32(frame.extent.z+8171u));temporalR[i]=restirGuide(g)?combine(g,src,gs,count,rng):emptyR();
