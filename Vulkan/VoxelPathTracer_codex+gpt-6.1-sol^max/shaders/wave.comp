}
Reservoir emptyR(){return Reservoir(uvec4(0),vec4(0));}
void selectSample(inout Reservoir r,uint lightID,vec2 uv,float w,inout uint rng){
    if(w<=0.0)return;r.value.w+=w;if(rnd(rng)*r.value.w<w){r.meta.x=lightID;r.meta.z=1u;r.value.xy=uv;}
}
Reservoir combine(Guide dst,Reservoir sources[5],Guide sourceGuides[5],uint count,inout uint rng){
    Reservoir r=emptyR();
    for(uint i=0u;i<count;++i){Reservoir s=sources[i];uint M=min(s.meta.y,32u);r.meta.y+=M;if(s.meta.z==0u)continue;float t=target(dst,s.meta.x,s.value.xy);selectSample(r,s.meta.x,s.value.xy,t*s.value.z*float(M),rng);}
    if(r.meta.z==0u)return r;
    // ReSTIR 支持域校正：选中 y 后，仅计入 target_source(y)>0 的 source multiplicity。
    // W = Σ(target_dst(y_i) W_i M_i) / (target_dst(y) Σ M_i 1[target_i(y)>0])。
    float Z=0.0;for(uint i=0u;i<count;++i)if(target(sourceGuides[i],r.meta.x,r.value.xy)>0.0)Z+=float(min(sources[i].meta.y,32u));
    float t=target(dst,r.meta.x,r.value.xy);r.value.z=(t>0.0&&Z>0.0)?r.value.w/(t*Z):0.0;
    r.meta.y=min(r.meta.y,32u);r.value.w=r.value.z*t*float(r.meta.y);return r;
}
bool restirGuide(Guide g){return g.ids.x!=0u&&g.chain.w==1u;}
void restirInitial(uint i){Guide g=guides[i*3u];Reservoir r=emptyR();if(restirGuide(g)&&frame.control.w>0u){uint rng=hash32(i^hash32(frame.extent.z+1987u));r.meta.y=4u;
    for(uint k=0u;k<4u;++k){uint l;vec2 uv=sampleLight(rng,l);float t=target(g,l,uv),q=lights[l].distribution.y/lights[l].distribution.x;selectSample(r,l,uv,t/q,rng);}
    if(r.meta.z!=0u){float t=target(g,r.meta.x,r.value.xy);r.value.z=t>0.0?r.value.w/(4.0*t):0.0;}}
    initialR[i]=r;
