vec3 demodulated(uint s){vec3 c=signals[s*2u].xyz;Guide g=guides[s];if(g.albedo.w==1.0)c=vec3(g.albedo.x>0.0?c.x/g.albedo.x:0.0,g.albedo.y>0.0?c.y/g.albedo.y:0.0,g.albedo.z>0.0?c.z/g.albedo.z:0.0);return c;}
