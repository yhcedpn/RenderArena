void restirSpatial(uint i){Guide g=guides[i*3u];if(!restirGuide(g)){spatialR[i]=emptyR();return;}Reservoir src[5];Guide gs[5];src[0]=temporalR[i];gs[0]=g;uint count=1u,rng=hash32(i^hash32(frame.extent.z+4523u));ivec2 p=ivec2(i%frame.extent.x,i/frame.extent.x);
