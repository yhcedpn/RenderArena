void variance(uint s){Guide g=guides[s];History h=history[s];float v=h.moments.w;if(h.moments.z<4.0&&g.ids.x!=0u){uint p=s/3u;ivec2 xy=ivec2(p%frame.extent.x,p/frame.extent.x);float wsum=0,m1=0,m2=0;
