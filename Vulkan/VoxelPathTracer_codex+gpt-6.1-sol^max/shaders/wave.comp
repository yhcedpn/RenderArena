layout(local_size_x=64) in;
uint workID(){return (gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x)*64u+gl_LocalInvocationID.x;}
void enqueue(Path p){uint j=atomicAdd(counters[1u-pc.queue],1u);if(pc.queue==0u)qb[j]=p;else qa[j]=p;}
void shadowTask(Guide g,uint lightID,vec2 uv,vec3 value,uint slot){
    vec3 dest=lightPoint(lightID,uv),o=offsetRay(g.actual.xyz,g.geometry.xyz,dest-g.actual.xyz),d=dest-o;float distance=length(d);
