#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_tracing : require
#include "common.glsl"
layout(set=0,binding=0) uniform accelerationStructureEXT world;
layout(location=1) rayPayloadEXT uint visible;
void main(){uint i=gl_LaunchIDEXT.y*gl_LaunchSizeEXT.x+gl_LaunchIDEXT.x;if(i>=counts[2])return;Shadow s=shadows[i];visible=0;traceRayEXT(world,gl_RayFlagsOpaqueEXT|gl_RayFlagsTerminateOnFirstHitEXT|gl_RayFlagsSkipClosestHitShaderEXT,255,0,0,1,s.o.xyz,0.00001,s.d.xyz,s.d.w,1);shadows[i].value.w=float(visible);}

