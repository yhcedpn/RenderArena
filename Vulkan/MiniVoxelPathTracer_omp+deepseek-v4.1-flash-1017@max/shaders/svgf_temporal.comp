#version 460

#include "scene.glsl"

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 10) readonly buffer JitterBuffer {
    vec2 items[];
} jitter;
// 每个信号槽独立历史；下标 = (signal * 2 + frameSlot) * N + pixel。
// rgb = 去调制颜色, w = history length。
layout(std430, set = 0, binding = 11) buffer TemporalColorBuffer {
    vec4 items[];
} temporalColor;
// x = 亮度方差, y = 一阶矩, z = 二阶矩。
layout(std430, set = 0, binding = 12) buffer TemporalMomentsBuffer {
    vec4 items[];
} temporalMoments;
layout(std430, set = 0, binding = 13) readonly buffer SlotRadianceBuffer {
    vec4 items[];
} slotRadiance;
layout(std430, set = 0, binding = 14) readonly buffer SlotGuidesBuffer {
    Guide items[];
} slotGuides;
layout(std430, set = 0, binding = 15) readonly buffer PrimaryInfoBuffer {
    PrimaryInfo items[];
} primaryInfos;

uint flatIndex() {
    uint row = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    return row * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

vec3 demodulate(vec3 c, vec3 a) {
    return vec3(a.x > 0.0 ? c.x / a.x : 0.0,
                a.y > 0.0 ? c.y / a.y : 0.0,
                a.z > 0.0 ? c.z / a.z : 0.0);
}

vec3 guideAlbedo(Guide g) {
    return guideValid(g.meta.z) ? g.albedo.xyz : vec3(1.0);
}

bool guideMatches(Guide a, Guide b, float posTol) {
    if (!guideValid(a.meta.z) || !guideValid(b.meta.z)) {
        return false;
    }
    if (a.meta.x != b.meta.x || a.meta.y != b.meta.y) {
        return false;
    }
    uint fa = a.meta.z;
    uint fb = b.meta.z;
    if (guideLobe(fa) != guideLobe(fb) || guideMotion(fa) != guideMotion(fb) ||
        guideChain(fa) != guideChain(fb) || guideDomain(fa) != guideDomain(fb) ||
        guideMaterial(fa) != guideMaterial(fb) ||
        guideChainLength(fa) != guideChainLength(fb)) {
        return false;
    }
    if (abs(a.posRough.w - b.posRough.w) > 0.1) {
        return false;
    }
    if (dot(normalize(a.nrm.xyz), normalize(b.nrm.xyz)) < 0.9) {
        return false;
    }
    if (distance(a.posRough.xyz, b.posRough.xyz) > posTol) {
        return false;
    }
    float hdTol = 0.5 + 0.02 * max(abs(a.nrm.w), abs(b.nrm.w));
    if (abs(a.nrm.w - b.nrm.w) > hdTol) {
        return false;
    }
    return true;
}

bool projectPrevious(vec3 world, out ivec2 pix) {
    Globals g = G();
    vec3 d = world - g.prevCamPos.xyz;
    float z = dot(d, g.prevCamFwd.xyz);
    if (z <= 0.01) {
        return false;
    }
    float tanHalf = g.prevCamPos.w;
    float aspect = g.prevCamFwd.w;
    float ndcX = dot(d, g.prevCamRight.xyz) / (z * tanHalf * aspect);
    float ndcY = dot(d, g.prevCamUp.xyz) / (z * tanHalf);
    vec2 uv = vec2(ndcX * 0.5 + 0.5, 0.5 - ndcY * 0.5);
    uint W = pc.width;
    uint H = pc.height;
    if (uv.x <= -0.01 || uv.x >= 1.01 || uv.y <= -0.01 || uv.y >= 1.01) {
        return false;
    }
    vec2 pf = uv * vec2(float(W), float(H)) - vec2(0.5);
    ivec2 p0 = ivec2(round(pf));
    if (p0.x < 0 || p0.x >= int(W) || p0.y < 0 || p0.y >= int(H)) {
        return false;
    }
    uint N = W * H;
    // 上一帧的 jitter 位于另一个 frame slot；当前世界位置已包含当前 jitter。
    uint prevJitterBlock = (1u - pc.slot) * N;
    vec2 j0 = jitter.items[prevJitterBlock + uint(p0.y) * W + uint(p0.x)];
    vec2 pf2 = uv * vec2(float(W), float(H)) - vec2(0.5) - j0;
    ivec2 p1 = clamp(ivec2(round(pf2)), ivec2(0), ivec2(int(W) - 1, int(H) - 1));
    vec2 j1 = jitter.items[prevJitterBlock + uint(p1.y) * W + uint(p1.x)];
    ivec2 p2 = ivec2(round(uv * vec2(float(W), float(H)) - vec2(0.5) - j1));
    if (p2.x < 0 || p2.x >= int(W) || p2.y < 0 || p2.y >= int(H)) {
        return false;
    }
    pix = p2;
    return true;
}

void main() {
    uint index = flatIndex();
    uint W = pc.width;
    uint H = pc.height;
    uint N = W * H;
    uint total = N * kSlotsPerPixel;
    if (index >= total) {
        return;
    }
    uint signal = index / N;
    uint pixel = index % N;
    uint slotIndex = signal * N + pixel;
    uint pixelX = pixel % W;
    uint pixelY = pixel / W;
    uint frameSlot = pc.slot;
    uint historyIndex = (signal * 2u + frameSlot) * N + pixel;
    uint guideIndex = frameSlot * (3u * N) + slotIndex;
    uint primaryIndex = frameSlot * N + pixel;
    Globals g = G();
    Guide guide = slotGuides.items[guideIndex];
    PrimaryInfo info = primaryInfos.items[primaryIndex];
    vec4 currentRadiance = slotRadiance.items[slotIndex];
    vec3 albedo = guideAlbedo(guide);
    vec3 currentColor = demodulate(currentRadiance.rgb, albedo);
    float currentLum = luminance3(currentColor);

    vec4 outColor = vec4(currentColor, 1.0);
    vec4 outMoments = vec4(0.0);

    if (!guideValid(guide.meta.z)) {
        // 无有效 guide：保留原始单样本贡献，方差归零，历史长度减一。
        float prevLen = temporalColor.items[historyIndex].w;
        outColor = vec4(currentColor, max(prevLen - 1.0, 0.0));
        outMoments = vec4(0.0, 0.0, 0.0, 0.0);
        temporalColor.items[historyIndex] = outColor;
        temporalMoments.items[historyIndex] = outMoments;
        return;
    }

    bool transmission = guideMotion(guide.meta.z) == MOTION_TRANSMISSION;
    bool historyAllowed = (g.flags.x != 0u) && (g.flags.y != 0u) &&
                          (!transmission || g.flags.z != 0u);

    bool prevValid = false;
    ivec2 prevPix = ivec2(0);
    if (historyAllowed) {
        if (transmission) {
            prevPix = ivec2(int(pixelX), int(pixelY));
            prevValid = true;
        } else if (guideMotion(guide.meta.z) == MOTION_PRIMARY) {
            if (info.pos.w >= 0.5) {
                prevValid = projectPrevious(info.pos.xyz, prevPix);
            }
        } else {
            prevValid = projectPrevious(guide.posRough.xyz, prevPix);
        }
    }

    // 世界单位容差：覆盖一个像素在给定深度上的世界尺寸以及 jitter 引起的偏移。
    float viewDepth = max(dot(guide.posRough.xyz - g.camPos.xyz, g.camFwd.xyz), 0.0);
    float posTol = 0.05 + 0.01 * viewDepth;
    if (transmission) {
        posTol = 0.08 + 0.02 * viewDepth;
    }
    float prevLen = 0.0;
    vec4 prevColor = vec4(0.0);
    vec4 prevMoments = vec4(0.0);
    if (prevValid) {
        uint prevHistory = (signal * 2u + (1u - frameSlot)) * N + uint(prevPix.y) * W +
                           uint(prevPix.x);
        uint prevGuideIndex = (1u - frameSlot) * (3u * N) + signal * N + uint(prevPix.y) * W +
                              uint(prevPix.x);
        Guide prevGuide = slotGuides.items[prevGuideIndex];
        if (!guideValid(prevGuide.meta.z) || prevGuide.meta.w + 1u != pc.frameIndex) {
            prevValid = false;
        } else if (!guideMatches(prevGuide, guide, posTol)) {
            prevValid = false;
        } else {
            prevColor = temporalColor.items[prevHistory];
            prevMoments = temporalMoments.items[prevHistory];
            prevLen = prevColor.w;
            if (prevLen <= 0.0) {
                prevValid = false;
            }
        }
    }

    float variance = 0.0;
    float m1 = currentLum;
    float m2 = currentLum * currentLum;
    if (prevValid) {
        float alpha = 1.0 / (min(prevLen, 31.0) + 1.0);
        float prevM1 = prevMoments.y;
        float prevM2 = prevMoments.z;
        m1 = mix(prevM1, currentLum, alpha);
        m2 = mix(prevM2, currentLum * currentLum, alpha);
        outColor = vec4(mix(prevColor.rgb, currentColor, alpha),
                        min(prevLen + 1.0, 32.0));
        variance = max(m2 - m1 * m1, 0.0);
    } else {
        outColor = vec4(currentColor, 1.0);
        variance = 0.0;
    }

    // 少于 4 个有效历史样本时，用 guide 兼容的 5x5 邻域构造空间方差。
    if (outColor.w < 4.0) {
        float sum = 0.0;
        float sum2 = 0.0;
        float count = 0.0;
        for (int dy = -2; dy <= 2; ++dy) {
            for (int dx = -2; dx <= 2; ++dx) {
                int nx = int(pixelX) + dx;
                int ny = int(pixelY) + dy;
                if (nx < 0 || nx >= int(W) || ny < 0 || ny >= int(H)) {
                    continue;
                }
                uint nidx = uint(ny) * W + uint(nx);
                uint nslot = signal * N + nidx;
                Guide ng = slotGuides.items[frameSlot * (3u * N) + nslot];
                if (!guideMatches(ng, guide, 0.03 + 0.01 * viewDepth)) {
                    continue;
                }
                vec3 na = guideAlbedo(ng);
                float lum = luminance3(demodulate(slotRadiance.items[nslot].rgb, na));
                sum += lum;
                sum2 += lum * lum;
                count += 1.0;
            }
        }
        if (count >= 2.0) {
            float mean = sum / count;
            float spatialVar = max(sum2 / count - mean * mean, 0.0);
            variance = max(variance, spatialVar);
        }
    }

    outMoments = vec4(variance, m1, m2, 0.0);
    temporalColor.items[historyIndex] = outColor;
    temporalMoments.items[historyIndex] = outMoments;
}
