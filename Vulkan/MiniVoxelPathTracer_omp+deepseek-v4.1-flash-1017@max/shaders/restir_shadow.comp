#version 460

#include "scene.glsl"

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 10) readonly buffer PrimaryInfoBuffer {
    PrimaryInfo items[];
} primaryInfos;
layout(std430, set = 0, binding = 11) readonly buffer HistoryBuffer {
    Reservoir items[];
} history;
layout(std430, set = 0, binding = 12) buffer ShadowTasksBuffer {
    ShadowTask items[];
} shadowTasks;
layout(std430, set = 0, binding = 13) buffer CountsBuffer {
    Counts c;
} counts;

uint flatIndex() {
    uint row = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    return row * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

void main() {
    uint index = flatIndex();
    uint N = pc.width * pc.height;
    if (index >= N) {
        return;
    }
    PrimaryInfo info = primaryInfos.items[pc.slot * N + index];
    if (info.pos.w < 0.5) {
        return;
    }
    Reservoir r = history.items[pc.slot * N + index];
    if (r.selected.y == 0u || r.weights.z <= 0.0 || r.weights.w <= 0.0) {
        return;
    }
    vec3 pos = info.pos.xyz;
    vec3 n = normalize(info.nrm.xyz);
    vec3 albedo = info.albedo.xyz;
    float rough = info.params.x;
    uint mat = uint(info.params.z);
    Globals g = G();
    vec3 wo = normalize(g.camPos.xyz - pos);
    vec3 targetRGB = reservoirTargetRGB(pos, n, wo, mat, albedo, rough, r.selected.x,
                                        r.weights.xy);
    float targetLum = luminance3(targetRGB);
    if (!(targetLum > 0.0)) {
        return;
    }
    vec3 estimator = targetRGB * (r.weights.z / (float(r.selected.y) *
                                                 max(r.weights.w, 1e-12)));
    if (luminance3(estimator) <= 0.0) {
        return;
    }
    vec3 lp = reconstructLightPoint(r.selected.x, r.weights.xy);
    Triangle tri = triangles.items[r.selected.x];
    vec3 d = lp - pos;
    float dist = length(d);
    if (dist < 1e-5) {
        return;
    }
    vec3 wi = d / dist;
    float cosR = dot(n, wi);
    float cosL = dot(normalize(tri.nrm.xyz), -wi);
    if (cosR <= 0.0 || cosL <= 0.0) {
        return;
    }
    vec3 origin = pos + n * 1e-3;
    vec3 dir = normalize(lp - origin);
    float tmax = length(lp - origin) - 1e-3;
    if (tmax <= 0.0) {
        return;
    }
    uint idx = atomicAdd(counts.c.shadowCount, 1u);
    if (idx < counts.c.shadowCapacity) {
        ShadowTask task;
        task.origin = vec4(origin, tmax);
        task.dir = vec4(dir, 0.0);
        task.weight = vec4(estimator, 0.0);
        task.meta = uvec4(index, 0u, 0u, 0u); // slot 0 的索引 = pixel
        shadowTasks.items[idx] = task;
    } else {
        atomicAdd(counts.c.overflowShadow, 1u);
    }
}
