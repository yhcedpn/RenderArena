#version 460

#include "scene.glsl"

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 10) readonly buffer PrimaryInfoBuffer {
    PrimaryInfo items[];
} primaryInfos;
layout(std430, set = 0, binding = 11) writeonly buffer ReservoirBuffer {
    Reservoir items[];
} reservoirs;

uint flatIndex() {
    uint row = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    return row * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

void main() {
    uint index = flatIndex();
    uint W = pc.width;
    uint H = pc.height;
    uint N = W * H;
    if (index >= N) {
        return;
    }
    PrimaryInfo info = primaryInfos.items[pc.slot * N + index];
    Reservoir empty;
    empty.selected = uvec4(0u);
    empty.weights = vec4(0.0);
    if (info.pos.w < 0.5) {
        reservoirs.items[index] = empty;
        return;
    }
    vec3 pos = info.pos.xyz;
    vec3 n = normalize(info.nrm.xyz);
    vec3 albedo = info.albedo.xyz;
    float rough = info.params.x;
    uint mat = uint(info.params.z);
    Globals g = G();
    vec3 wo = normalize(g.camPos.xyz - pos);
    uint rng = hashCombine(hashCombine(index, pc.frameIndex * 0x9e3779b9u), 0xBEEFu);

    float wSum = 0.0;
    float chosenTargetLum = 0.0;
    uint chosenTri = 0u;
    vec2 chosenBary = vec2(0.0);
    bool have = false;
    for (int j = 0; j < 4; ++j) {
        LightSample ls;
        if (!sampleLight(rng, ls)) {
            continue;
        }
        vec3 target = evalDirectTarget(mat, pos, n, wo, albedo, rough, ls);
        float tl = luminance3(target);
        float w = tl / max(ls.pdfArea, 1e-12);
        if (w > 0.0) {
            wSum += w;
            if (rand01(rng) * wSum < w) {
                chosenTri = ls.triangle;
                chosenBary = ls.bary;
                chosenTargetLum = tl;
                have = true;
            }
        }
    }
    Reservoir outRes;
    outRes.selected = uvec4(chosenTri, 4u, have ? 1u : 0u, 0u);
    outRes.weights = vec4(chosenBary, wSum, chosenTargetLum);
    reservoirs.items[index] = outRes;
}
