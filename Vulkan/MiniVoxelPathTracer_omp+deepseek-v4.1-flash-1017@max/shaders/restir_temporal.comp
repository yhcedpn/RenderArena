#version 460

#include "scene.glsl"

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 10) readonly buffer PrimaryInfoBuffer {
    PrimaryInfo items[];
} primaryInfos;
layout(std430, set = 0, binding = 11) readonly buffer JitterBuffer {
    vec2 items[];
} jitter;
layout(std430, set = 0, binding = 12) readonly buffer InitBuffer {
    Reservoir items[];
} initReservoirs;
layout(std430, set = 0, binding = 13) readonly buffer HistoryBuffer {
    Reservoir items[];
} history;
layout(std430, set = 0, binding = 14) writeonly buffer TemporalBuffer {
    Reservoir items[];
} temporal;

uint flatIndex() {
    uint row = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    return row * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

bool sourceValid(Reservoir r) {
    return r.selected.y > 0u && r.weights.z > 0.0 && r.weights.w > 0.0;
}

float sourceWeight(Reservoir r, vec3 pos, vec3 n, vec3 wo, uint mat, vec3 albedo, float rough) {
    float t = reservoirTargetLum(pos, n, wo, mat, albedo, rough, r.selected.x, r.weights.xy);
    return t * r.weights.z / max(r.weights.w, 1e-12);
}

void main() {
    uint index = flatIndex();
    uint W = pc.width;
    uint H = pc.height;
    uint N = W * H;
    if (index >= N) {
        return;
    }
    uint pixelX = index % W;
    uint pixelY = index / W;
    PrimaryInfo info = primaryInfos.items[pc.slot * N + index];
    Reservoir empty;
    empty.selected = uvec4(0u);
    empty.weights = vec4(0.0);
    if (info.pos.w < 0.5) {
        temporal.items[index] = empty;
        return;
    }
    vec3 pos = info.pos.xyz;
    vec3 n = normalize(info.nrm.xyz);
    vec3 albedo = info.albedo.xyz;
    float rough = info.params.x;
    uint mat = uint(info.params.z);
    uint domain = uint(info.params.w);
    uint lobe = uint(info.params.y);
    Globals g = G();
    vec3 wo = normalize(g.camPos.xyz - pos);
    uint rng = hashCombine(hashCombine(index, pc.frameIndex * 0x9e3779b9u), 0xDEADu);

    Reservoir initRes = initReservoirs.items[index];
    float aInit = 0.0;
    if (sourceValid(initRes)) {
        aInit = sourceWeight(initRes, pos, n, wo, mat, albedo, rough);
    }

    // 无 jitter 前一帧相机投影 + 两帧 jitter 补偿。
    bool prevValid = false;
    ivec2 prevPix = ivec2(0);
    if (g.flags.x != 0u) {
        vec3 d = pos - g.prevCamPos.xyz;
        float z = dot(d, g.prevCamFwd.xyz);
        if (z > 0.01) {
            float tanHalf = g.prevCamPos.w;
            float aspect = g.prevCamFwd.w;
            float ndcX = dot(d, g.prevCamRight.xyz) / (z * tanHalf * aspect);
            float ndcY = dot(d, g.prevCamUp.xyz) / (z * tanHalf);
            vec2 uv = vec2(ndcX * 0.5 + 0.5, 0.5 - ndcY * 0.5);
            if (uv.x > -0.01 && uv.x < 1.01 && uv.y > -0.01 && uv.y < 1.01) {
                vec2 pf = uv * vec2(float(W), float(H)) - vec2(0.5);
                ivec2 p0 = ivec2(round(pf));
                if (p0.x >= 0 && p0.x < int(W) && p0.y >= 0 && p0.y < int(H)) {
                    vec2 j0 = jitter.items[(1u - pc.slot) * N + uint(p0.y) * W + uint(p0.x)];
                    vec2 pf2 = uv * vec2(float(W), float(H)) - vec2(0.5) - j0;
                    ivec2 p1 = ivec2(round(pf2));
                    p1 = clamp(p1, ivec2(0), ivec2(int(W) - 1, int(H) - 1));
                    vec2 j1 = jitter.items[(1u - pc.slot) * N + uint(p1.y) * W + uint(p1.x)];
                    ivec2 p2 = ivec2(round(uv * vec2(float(W), float(H)) - vec2(0.5) - j1));
                    if (p2.x >= 0 && p2.x < int(W) && p2.y >= 0 && p2.y < int(H)) {
                        prevPix = p2;
                        prevValid = true;
                    }
                }
            }
        }
    }

    Reservoir prevRes = empty;
    uint prevM = 0u;
    float aPrev = 0.0;
    if (prevValid) {
        uint prevIndex = (1u - pc.slot) * N + uint(prevPix.y) * W + uint(prevPix.x);
        PrimaryInfo prevInfo = primaryInfos.items[prevIndex];
        float viewDepth = max(dot(pos - g.camPos.xyz, g.camFwd.xyz), 0.0);
        float posTol = 0.01 + 0.002 * viewDepth;
        bool ok = prevInfo.pos.w >= 0.5;
        if (ok && (uint(prevInfo.params.y) != lobe || uint(prevInfo.params.z) != mat ||
                   uint(prevInfo.params.w) != domain)) {
            ok = false;
        }
        if (ok && distance(prevInfo.pos.xyz, pos) > posTol) {
            ok = false;
        }
        if (ok && dot(normalize(prevInfo.nrm.xyz), n) < 0.9) {
            ok = false;
        }
        if (ok) {
            prevRes = history.items[prevIndex];
            if (!sourceValid(prevRes)) {
                ok = false;
            }
        }
        if (ok) {
            prevValid = true;
            prevM = prevRes.selected.y;
            if (prevM > 32u) {
                prevRes.weights.z *= 32.0 / float(prevM);
                prevM = 32u;
            }
            aPrev = sourceWeight(prevRes, pos, n, wo, mat, albedo, rough);
        } else {
            prevValid = false;
        }
    }

    uint totalM = 4u + (prevValid ? prevM : 0u);
    float wSum = 0.0;
    bool have = false;
    uint chosenTri = 0u;
    vec2 chosenBary = vec2(0.0);
    uint chosenSource = 0u;
    if (aInit > 0.0) {
        wSum += aInit;
        if (rand01(rng) * wSum < aInit) {
            have = true;
            chosenSource = 0u;
        }
    }
    if (aPrev > 0.0) {
        wSum += aPrev;
        if (rand01(rng) * wSum < aPrev) {
            have = true;
            chosenSource = 1u;
        }
    }
    Reservoir outRes = empty;
    if (have && wSum > 0.0) {
        Reservoir chosen = chosenSource == 0u ? initRes : prevRes;
        chosenTri = chosen.selected.x;
        chosenBary = chosen.weights.xy;
        float chosenTarget =
            reservoirTargetLum(pos, n, wo, mat, albedo, rough, chosenTri, chosenBary);
        outRes.selected = uvec4(chosenTri, totalM, 1u, 0u);
        outRes.weights = vec4(chosenBary, wSum, chosenTarget);
    }
    temporal.items[index] = outRes;
}
