#version 460

#include "scene.glsl"

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 10) readonly buffer HitsBuffer {
    HitPayload items[];
} hitResults;
layout(std430, set = 0, binding = 11) writeonly buffer PrimaryInfoBuffer {
    PrimaryInfo items[];
} primaryInfos;
layout(std430, set = 0, binding = 12) readonly buffer PathsBuffer {
    Path items[];
} paths;

uint flatIndex() {
    uint row = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    return row * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

void main() {
    uint index = flatIndex();
    uint N = pc.width * pc.height;
    if (index >= N) {
        return;
    }
    PrimaryInfo info;
    info.pos = vec4(0.0);
    info.nrm = vec4(0.0);
    info.albedo = vec4(0.0);
    info.params = vec4(0.0, 0.0, 0.0, float(DOMAIN_NONE));

    HitPayload h = hitResults.items[index];
    if (h.normal.w >= 0.5) {
        Path p = paths.items[index];
        uint inst = h.geom.x;
        uint prim = h.geom.y;
        uint triIndex = instanceGroups.items[inst].data.x + prim;
        Triangle tri = triangles.items[triIndex];
        uint mat = tri.aux.x;
        uint type = materialType(mat);
        if (type == MAT_DIFFUSE || type == MAT_ROUGH_METAL) {
            vec3 rayDir = normalize(p.dir.xyz);
            vec3 gn = normalize(tri.nrm.xyz);
            vec3 nf = dot(rayDir, gn) < 0.0 ? gn : -gn;
            float footprint = p.prevPos.w + h.pos.w * p.dir.w;
            vec2 uv = faceUV(h.pos.xyz, nf);
            float lod = computeLod(footprint, dot(nf, -rayDir));
            vec3 albedo = sampleBase(mat, uv, lod);
            float rough = sampleRough(mat, uv, lod);
            Globals g = G();
            float viewDepth = max(dot(h.pos.xyz - g.camPos.xyz, g.camFwd.xyz), 0.0);
            uint lobe = type == MAT_DIFFUSE ? LOBE_DIFFUSE : LOBE_GLOSSY;
            uint domain = type == MAT_DIFFUSE ? DOMAIN_PRIMARY_DIFFUSE : DOMAIN_PRIMARY_GLOSSY;
            info.pos = vec4(h.pos.xyz, 1.0);
            info.nrm = vec4(nf, viewDepth);
            info.albedo = vec4(albedo, 0.0);
            info.params = vec4(rough, float(lobe), float(mat), float(domain));
        }
    }
    primaryInfos.items[pc.slot * N + index] = info;
}
