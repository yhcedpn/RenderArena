#version 460

#include "globals.glsl"

layout(local_size_x = 1) in;

layout(std430, set = 0, binding = 10) buffer CountsBuffer {
    Counts c;
} counts;
layout(std430, set = 0, binding = 11) writeonly buffer IndirectBuffer {
    uvec4 items[4];
} indirect;

uvec4 calcTrace(uint count, uint maxX, uint maxY) {
    if (count == 0u) {
        return uvec4(1u, 1u, 1u, 0u);
    }
    uint width = max(1u, min(count, maxX));
    uint height = max(1u, min((count + width - 1u) / width, maxY));
    uint depth = max(1u, (count + width * height - 1u) / (width * height));
    return uvec4(width, height, depth, 0u);
}

uvec4 calcDispatch(uint count, uint maxX, uint maxY) {
    uint groups = (count + 63u) / 64u;
    uint gx = max(1u, min(groups, maxX));
    uint gy = max(1u, min((groups + gx - 1u) / gx, maxY));
    uint gz = max(1u, (groups + gx * gy - 1u) / (gx * gy));
    return uvec4(gx, gy, gz, 0u);
}

void main() {
    Globals g = globals.items[pc.slot];
    uint maxX = max(g.misc.x, 1u);
    uint maxY = max(g.misc.y, 1u);
    if (pc.flags == 0u) {
        uint pathCount = min(counts.c.nextPathCount, counts.c.pathCapacity);
        uint shadowCount = min(counts.c.nextShadowCount, counts.c.shadowCapacity);
        indirect.items[0] = calcTrace(pathCount, maxX, maxY);
        indirect.items[1] = calcTrace(shadowCount, maxX, maxY);
        indirect.items[2] = calcDispatch(pathCount, maxX, maxY);
        indirect.items[3] = calcDispatch(shadowCount, maxX, maxY);
        counts.c.pathCount = pathCount;
        counts.c.shadowCount = shadowCount;
        counts.c.nextPathCount = 0u;
        counts.c.nextShadowCount = 0u;
    } else {
        uint shadowCount = min(counts.c.shadowCount, counts.c.shadowCapacity);
        indirect.items[1] = calcTrace(shadowCount, maxX, maxY);
        indirect.items[3] = calcDispatch(shadowCount, maxX, maxY);
    }
}
