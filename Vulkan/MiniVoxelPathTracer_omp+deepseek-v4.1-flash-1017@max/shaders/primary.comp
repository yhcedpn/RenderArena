#version 460

#include "globals.glsl"

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 10) buffer PathsBuffer {
    Path items[];
} paths;
layout(std430, set = 0, binding = 11) buffer CountsBuffer {
    Counts c;
} counts;
layout(std430, set = 0, binding = 12) buffer JitterBuffer {
    vec2 items[];
} jitter;

uint flatIndex() {
    uint row = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    return row * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

void main() {
    uint index = flatIndex();
    uint W = pc.width;
    uint H = pc.height;
    uint N = W * H;
    if (index >= N) {
        return;
    }
    Globals g = globals.items[pc.slot];
    uint px = index % W;
    uint py = index / W;

    uint jitterSeed = hashCombine(hashCombine(index, pc.frameIndex * 0x9e3779b9u), 0x1234u);
    vec2 jit = rand2(jitterSeed) - vec2(0.5);
    jitter.items[pc.slot * N + index] = jit;

    float pxCenter = float(px) + 0.5 + jit.x;
    float pyCenter = float(py) + 0.5 + jit.y;
    vec2 ndc = vec2(pxCenter / float(W) * 2.0 - 1.0, 1.0 - pyCenter / float(H) * 2.0);
    float tanHalf = g.camPos.w;
    float aspect = g.camFwd.w;
    vec3 dir = normalize(g.camFwd.xyz + ndc.x * tanHalf * aspect * g.camRight.xyz +
                         ndc.y * tanHalf * g.camUp.xyz);
    float tmin = 0.05 / max(dot(dir, g.camFwd.xyz), 1e-6);

    bool insideGlass = all(greaterThanEqual(g.camPos.xyz, g.glassMin.xyz)) &&
                       all(lessThanEqual(g.camPos.xyz, g.glassMax.xyz));

    uint pathSeed = hashCombine(hashCombine(index, pc.frameIndex * 0x85ebca6bu), 0x5678u);
    Path p;
    p.origin = vec4(g.camPos.xyz, tmin);
    p.dir = vec4(dir, 2.0 * tanHalf / float(H));
    p.throughput = vec4(1.0, 1.0, 1.0, 0.0);
    p.prevPos = vec4(0.0);
    p.prevNormal = vec4(0.0);
    p.virtualT = identityTransform();
    uint flags = 0u;
    flags = pathSetFlag(flags, PATH_MEDIUM, insideGlass);
    p.meta0 = uvec4(index, pathSeed, 0u, flags);
    p.meta1 = uvec4(0u, DOMAIN_NONE, 0u, 0u);
    paths.items[index] = p;

    if (index == 0u) {
        counts.c.pathCount = N;
        counts.c.shadowCount = 0u;
        counts.c.nextPathCount = 0u;
        counts.c.nextShadowCount = 0u;
        counts.c.pathCapacity = N * 2u;
        counts.c.shadowCapacity = N * 2u;
        counts.c.overflowPath = 0u;
        counts.c.overflowShadow = 0u;
    }
}
