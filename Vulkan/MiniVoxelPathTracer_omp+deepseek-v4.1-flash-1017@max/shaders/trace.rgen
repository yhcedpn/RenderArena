#version 460
#extension GL_EXT_ray_tracing : require

#include "common.glsl"

layout(set = 0, binding = 0) readonly buffer PathsBuffer {
    Path items[];
} paths;
layout(set = 0, binding = 1) writeonly buffer HitsBuffer {
    HitPayload items[];
} hitResults;
layout(set = 0, binding = 2) readonly buffer ShadowTasksBuffer {
    ShadowTask items[];
} shadowTasks;
layout(set = 0, binding = 3) writeonly buffer ShadowResultsBuffer {
    uint items[];
} shadowResults;
layout(set = 0, binding = 4) readonly buffer CountsBuffer {
    Counts c;
} counts;
layout(set = 0, binding = 5) uniform accelerationStructureEXT tlas;

layout(location = 0) rayPayloadEXT HitPayload payload;

uint flatIndex() {
    return (gl_LaunchIDEXT.z * gl_LaunchSizeEXT.y + gl_LaunchIDEXT.y) * gl_LaunchSizeEXT.x +
           gl_LaunchIDEXT.x;
}

void main() {
    uint index = flatIndex();
    if (index >= counts.c.pathCount) {
        return;
    }
    uint base = pc.queueCur * counts.c.pathCapacity;
    Path p = paths.items[base + index];
    payload.pos = vec4(0.0);
    payload.normal = vec4(0.0);
    payload.geom = uvec4(0u);
    traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0xFFu, 0u, 1u, 0u, p.origin.xyz, p.origin.w,
                normalize(p.dir.xyz), 1e30, 0);
    hitResults.items[index] = payload;
}
